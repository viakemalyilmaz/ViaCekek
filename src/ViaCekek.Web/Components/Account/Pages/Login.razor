@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using ViaCekek.Web.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<Login> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>Giriş Yap</PageTitle>

<h1>Giriş Yap</h1>
<div class="row">
    <div class="col-md-4">
        <section>
            <StatusMessage Message="@errorMessage" />
            <EditForm Model="Input" method="post" OnValidSubmit="FormuGonder" FormName="login">
                <DataAnnotationsValidator />
                <h2>Yerel hesapla giriş yapın</h2>
                <hr />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.KullaniciAdi" class="form-control" autocomplete="username" aria-required="true" placeholder="kullanıcı adı" />
                    <label for="kullaniciAdi" class="form-label">Kullanıcı Adı</label>
                    <ValidationMessage For="() => Input.KullaniciAdi" class="text-danger" />
                </div>
                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="şifre" />
                    <label for="password" class="form-label">Şifre</label>
                    <ValidationMessage For="() => Input.Password" class="text-danger" />
                </div>

                @* Statik (interaktif olmayan) bir sayfa olduğu için checkbox'ın
                   işaretlenmesi sunucuya bildirilmeden tarayıcıda hemen yansımalı
                   — bu yüzden alanlar/butonlar @if ile değil, saf CSS
                   (:has() ile checked durumu, navbar hamburger menüsündeki
                   :checked ~ deseninin aynı fikri) ile gösterilip gizleniyor;
                   ikisi de DOM'da her zaman var. *@
                <div class="form-check mb-3 login-sifre-toggle-satiri">
                    <InputCheckbox @bind-Value="Input.SifreDegistirModu" class="form-check-input login-sifre-toggle" id="sifreDegistirModu" />
                    <label class="form-check-label" for="sifreDegistirModu">Şifremi değiştirmek istiyorum</label>
                </div>

                <div class="login-yeni-sifre-alani form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.YeniSifre" class="form-control" autocomplete="new-password" placeholder="yeni şifre" id="yeniSifre" />
                    <label for="yeniSifre" class="form-label">Yeni Şifre</label>
                </div>

                <div class="login-varsayilan-alan checkbox mb-3">
                    <label class="form-label">
                        <InputCheckbox @bind-Value="Input.RememberMe" class="darker-border-checkbox form-check-input" />
                        Beni hatırla
                    </label>
                </div>

                <div class="login-giris-butonu">
                    <button type="submit" class="w-100 btn btn-lg btn-primary">Giriş Yap</button>
                </div>
                <div class="login-sifre-degistir-butonu">
                    <button type="submit" class="w-100 btn btn-lg btn-primary">Şifre Değiştir</button>
                </div>

                <p class="login-varsayilan-alan text-muted mt-3">
                    Şifrenizi unuttuysanız yöneticinizle iletişime geçin.
                </p>
            </EditForm>
        </section>
    </div>
</div>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Clear the existing external cookie to ensure a clean login process
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    private async Task FormuGonder()
    {
        if (Input.SifreDegistirModu)
        {
            await SifreDegistirVeGirisYap();
        }
        else
        {
            await LoginUser();
        }
    }

    public async Task LoginUser()
    {
        // This doesn't count login failures towards account lockout
        // To enable password failures to trigger account lockout, set lockoutOnFailure: true
        var result = await SignInManager.PasswordSignInAsync(Input.KullaniciAdi, Input.Password, Input.RememberMe, lockoutOnFailure: false);
        if (result.Succeeded)
        {
            Logger.LogInformation("User logged in.");
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.RequiresTwoFactor)
        {
            RedirectManager.RedirectTo(
                "Account/LoginWith2fa",
                new() { ["returnUrl"] = ReturnUrl, ["rememberMe"] = Input.RememberMe });
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("User account locked out.");
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            errorMessage = "Hata: Geçersiz giriş denemesi.";
        }
    }

    // Kullanıcının kendi şifresini, girişten önce, mevcut şifresini
    // doğrulayarak değiştirmesi için — bkz. CLAUDE.md: bu bilerek
    // authenticated Manage/ChangePassword sayfası yerine Login'e
    // eklendi (o sayfa LoginDisplay ile aynı Scoped DbContext'i
    // paylaştığı için "A second operation was started..." hatası
    // veriyordu; anonim Login sayfasında bu çakışma hiç oluşmuyor).
    private async Task SifreDegistirVeGirisYap()
    {
        if (string.IsNullOrWhiteSpace(Input.YeniSifre))
        {
            errorMessage = "Hata: Yeni şifre zorunlu.";
            return;
        }

        var kullanici = await UserManager.FindByNameAsync(Input.KullaniciAdi);
        if (kullanici is null)
        {
            errorMessage = "Hata: Kullanıcı adı veya şifre hatalı.";
            return;
        }

        var sonuc = await UserManager.ChangePasswordAsync(kullanici, Input.Password, Input.YeniSifre);
        if (!sonuc.Succeeded)
        {
            errorMessage = "Hata: " + string.Join(" ", sonuc.Errors.Select(e => e.Description));
            return;
        }

        Logger.LogInformation("User changed their own password.");

        var girisSonucu = await SignInManager.PasswordSignInAsync(Input.KullaniciAdi, Input.YeniSifre, Input.RememberMe, lockoutOnFailure: false);
        if (girisSonucu.Succeeded)
        {
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else
        {
            RedirectManager.RedirectToWithStatus("Account/Login", "Şifreniz değiştirildi. Lütfen yeni şifrenizle giriş yapın.", HttpContext);
        }
    }

    private sealed class InputModel
    {
        [Required]
        public string KullaniciAdi { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = "Beni hatırla")]
        public bool RememberMe { get; set; }

        public bool SifreDegistirModu { get; set; }

        [DataType(DataType.Password)]
        public string? YeniSifre { get; set; }
    }
}
