@inherits LayoutComponentBase
@using ViaCekek.Web.Data
@inject IWebHostEnvironment Env

<div class="app-shell">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
    @* data-enhance-nav="false": Board zaten açıkken logoya basılınca da tam sayfa
       yüklemesi olsun — enhanced navigation aynı URL'de bileşeni yeniden
       oluşturmadığı için liste tazelenmiyordu. *@
    <a class="navbar-brand" href="/" data-enhance-nav="false">ViaÇekek</a>
    <div class="navbar-nav navbar-nav-priority flex-row">
        <AuthorizeView Roles="@($"{Roller.Yonetici},{Roller.SahaKontroloru},{Roller.Guvenlik}")">
            <Authorized>
                <a class="nav-link" href="cekektakip">Çekek Takip</a>
                <a class="nav-link" href="kisiler">Kişiler</a>
                <a class="nav-link" href="araclar">Araçlar</a>
            </Authorized>
        </AuthorizeView>
    </div>
    <input class="navbar-toggle-checkbox" type="checkbox" id="ana-menu-toggle" />
    <label class="navbar-toggler" for="ana-menu-toggle" aria-label="Menüyü aç/kapat">
        <span class="navbar-toggler-icon"></span>
    </label>
    <div class="collapse navbar-collapse">
        <div class="navbar-nav me-auto">
            <AuthorizeView Roles="@($"{Roller.Yonetici},{Roller.SahaKontroloru}")">
                <Authorized>
                    <a class="nav-link" href="tekneler">Tekneler</a>
                    <a class="nav-link" href="kisibelgeleri">Kişi Belgeleri</a>
                    <a class="nav-link" href="aracbelgeleri">Araç Belgeleri</a>
                    <a class="nav-link" href="tekneraporu">Tekneler Raporu</a>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="@($"{Roller.Yonetici},{Roller.SahaKontroloru},{Roller.OnBuro}")">
                <Authorized>
                    <a class="nav-link" href="rapor">Takip Raporu</a>
                    <a class="nav-link" href="kisilerraporu">Kişiler Raporu</a>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="@Roller.Yonetici">
                <Authorized>
                    <a class="nav-link" href="kullanicilar">Kullanıcılar</a>
                </Authorized>
            </AuthorizeView>
            <a class="nav-link" href="docs/ViaCekek_Kullanim_Kilavuzu.pdf?v=@KilavuzVersiyonu()" target="_blank">Yardım</a>
        </div>
        <LoginDisplay />
    </div>
</nav>

<main class="app-main container-fluid py-3">
    <div class="app-page-content">
        @Body
    </div>
</main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    // Kılavuz PDF'i güncellendiğinde tarayıcının eski sürümü önbellekten
    // göstermemesi için (app.css/app.js'teki DosyaVersiyonu deseni, bkz. App.razor).
    private string KilavuzVersiyonu()
    {
        var yol = Path.Combine(Env.WebRootPath, "docs", "ViaCekek_Kullanim_Kilavuzu.pdf");
        return File.Exists(yol)
            ? File.GetLastWriteTimeUtc(yol).Ticks.ToString()
            : "0";
    }
}
