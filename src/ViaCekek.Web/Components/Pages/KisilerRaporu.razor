@page "/kisilerraporu"
@attribute [Authorize(Roles = $"{Roller.Yonetici},{Roller.SahaKontroloru}")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ViaCekek.Web.Data
@using ViaCekek.Web.Models
@using ClosedXML.Excel
@inject ApplicationDbContext Db
@inject IJSRuntime JS

<PageTitle>Kişiler Raporu</PageTitle>

<h3>Kişiler Raporu</h3>

<div class="card card-body mb-3">
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Kimlik No</label>
            <div class="input-group">
                <select class="form-select" style="max-width: 140px;" @bind="kimlikFiltre.Operator">
                    <option value="@MetinOperatoru.Icerir">İçerir</option>
                    <option value="@MetinOperatoru.Esittir">Eşittir</option>
                    <option value="@MetinOperatoru.BaslarIle">Başlar ile</option>
                </select>
                <input class="form-control" @bind="kimlikFiltre.Deger" />
            </div>
        </div>

        <div class="col-md-4">
            <label class="form-label">Ad Soyad</label>
            <div class="input-group">
                <select class="form-select" style="max-width: 140px;" @bind="adSoyadFiltre.Operator">
                    <option value="@MetinOperatoru.Icerir">İçerir</option>
                    <option value="@MetinOperatoru.Esittir">Eşittir</option>
                    <option value="@MetinOperatoru.BaslarIle">Başlar ile</option>
                </select>
                <input class="form-control" @bind="adSoyadFiltre.Deger" />
            </div>
        </div>

        <div class="col-md-4">
            <label class="form-label">Firma Adı</label>
            <div class="input-group">
                <select class="form-select" style="max-width: 140px;" @bind="firmaFiltre.Operator">
                    <option value="@MetinOperatoru.Icerir">İçerir</option>
                    <option value="@MetinOperatoru.Esittir">Eşittir</option>
                    <option value="@MetinOperatoru.BaslarIle">Başlar ile</option>
                </select>
                <input class="form-control" @bind="firmaFiltre.Deger" />
            </div>
        </div>

        <div class="col-md-4">
            <label class="form-label">Telefon</label>
            <div class="input-group">
                <select class="form-select" style="max-width: 140px;" @bind="telefonFiltre.Operator">
                    <option value="@MetinOperatoru.Icerir">İçerir</option>
                    <option value="@MetinOperatoru.Esittir">Eşittir</option>
                    <option value="@MetinOperatoru.BaslarIle">Başlar ile</option>
                </select>
                <input class="form-control" @bind="telefonFiltre.Deger" />
            </div>
        </div>

        <div class="col-md-4">
            <label class="form-label">Aktif</label>
            <select class="form-select" @bind="aktifSecim">
                <option value="">Tümü</option>
                <option value="true">Aktif</option>
                <option value="false">Pasif</option>
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">KVKK Onay Durumu</label>
            <select class="form-select" @bind="kvkkOnayDurumuFiltre">
                <option value="">Tümü</option>
                <option value="@KvkkOnayDurumu.Bilinmiyor">Bilinmiyor</option>
                <option value="@KvkkOnayDurumu.OnayVerildi">Onay Verildi</option>
                <option value="@KvkkOnayDurumu.OnayVerilmedi">Onay Verilmedi</option>
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">KVKK Onay Formu Alındı</label>
            <select class="form-select" @bind="kvkkOnayFormuAlindiSecim">
                <option value="">Tümü</option>
                <option value="true">Evet</option>
                <option value="false">Hayır</option>
            </select>
        </div>

        <div class="col-md-6">
            <label class="form-label">KVKK Onay Tarihi</label>
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <select class="form-select" style="max-width: 130px;" @bind="kvkkOnayTarihiFiltre.Operator">
                    <option value="@TarihOperatoru.Once">Öncesi</option>
                    <option value="@TarihOperatoru.Sonra">Sonrası</option>
                    <option value="@TarihOperatoru.Esittir">Eşittir</option>
                    <option value="@TarihOperatoru.Arasi">Arası</option>
                </select>
                <input type="date" class="form-control" style="max-width: 170px;" @bind="kvkkOnayTarihiFiltre.Tarih1" />
                @if (kvkkOnayTarihiFiltre.Operator == TarihOperatoru.Arasi)
                {
                    <span>—</span>
                    <input type="date" class="form-control" style="max-width: 170px;" @bind="kvkkOnayTarihiFiltre.Tarih2" />
                }
            </div>
        </div>

        <div class="col-md-3">
            <label class="form-label">Kaptan</label>
            <select class="form-select" @bind="kaptanSecim">
                <option value="">Tümü</option>
                <option value="true">Evet</option>
                <option value="false">Hayır</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Tekne Sahibi</label>
            <select class="form-select" @bind="tekneSahibiSecim">
                <option value="">Tümü</option>
                <option value="true">Evet</option>
                <option value="false">Hayır</option>
            </select>
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-lg btn-primary" @onclick="Filtrele">Filtrele</button>
        <button class="btn btn-lg btn-secondary" @onclick="FiltreleriTemizle">Temizle</button>
        <button class="btn btn-lg btn-success" @onclick="ExcelAktar" disabled="@(sonuclar is null || sonuclar.Count == 0)">Excel'e Aktar</button>
    </div>
</div>

@if (sonuclar is null)
{
    <p>Filtrelemek için "Filtrele"ye basın.</p>
}
else if (sonuclar.Count == 0)
{
    <p>Sonuç bulunamadı.</p>
}
else
{
    <p>@sonuclar.Count kayıt bulundu.</p>
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Kimlik No</th>
                    <th>Ad Soyad</th>
                    <th>Firma</th>
                    <th>Telefon</th>
                    <th>Aktif</th>
                    <th>KVKK Onay Durumu</th>
                    <th>KVKK Onay Formu Alındı</th>
                    <th>KVKK Onay Tarihi</th>
                    <th>Kaptan</th>
                    <th>Tekne Sahibi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kisi in sonuclar)
                {
                    <tr>
                        <td>@kisi.KimlikNumarasi</td>
                        <td>@kisi.AdSoyad</td>
                        <td>@kisi.FirmaAdi</td>
                        <td>@kisi.Telefon</td>
                        <td>@(kisi.Aktif ? "Aktif" : "Pasif")</td>
                        <td>@KvkkOnayDurumuAdi(kisi.KvkkOnayDurumu)</td>
                        <td>@(kisi.KvkkOnayFormuAlindi ? "Evet" : "Hayır")</td>
                        <td>@KvkkOnayTarihiMetni(kisi)</td>
                        <td>@(kisi.Kaptan ? "Evet" : "Hayır")</td>
                        <td>@(kisi.TekneSahibi ? "Evet" : "Hayır")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private enum MetinOperatoru { Icerir, Esittir, BaslarIle }
    private enum TarihOperatoru { Once, Sonra, Esittir, Arasi }

    private sealed class MetinFiltre
    {
        public MetinOperatoru Operator { get; set; } = MetinOperatoru.Icerir;
        public string Deger { get; set; } = string.Empty;
    }

    private sealed class TarihFiltre
    {
        public TarihOperatoru Operator { get; set; } = TarihOperatoru.Once;
        public DateOnly? Tarih1 { get; set; }
        public DateOnly? Tarih2 { get; set; }
    }

    private MetinFiltre kimlikFiltre = new();
    private MetinFiltre adSoyadFiltre = new();
    private MetinFiltre firmaFiltre = new();
    private MetinFiltre telefonFiltre = new();
    private TarihFiltre kvkkOnayTarihiFiltre = new();
    private string aktifSecim = string.Empty;
    private KvkkOnayDurumu? kvkkOnayDurumuFiltre;
    private string kvkkOnayFormuAlindiSecim = string.Empty;
    private string kaptanSecim = string.Empty;
    private string tekneSahibiSecim = string.Empty;

    private static bool? SecimToBool(string secim) => secim switch
    {
        "true" => true,
        "false" => false,
        _ => null
    };

    private List<Kisi>? sonuclar;

    private static string KvkkOnayDurumuAdi(KvkkOnayDurumu durum) => durum switch
    {
        KvkkOnayDurumu.Bilinmiyor => "Bilinmiyor",
        KvkkOnayDurumu.OnayVerildi => "Onay Verildi",
        KvkkOnayDurumu.OnayVerilmedi => "Onay Verilmedi",
        _ => durum.ToString()
    };

    private static string KvkkOnayTarihiMetni(Kisi kisi) =>
        kisi.KvkkOnayTarihi is { } t ? $"{t:dd.MM.yyyy}" : "";

    private async Task Filtrele()
    {
        var sorgu = Db.Kisiler.AsNoTracking().AsQueryable();

        if (!string.IsNullOrWhiteSpace(kimlikFiltre.Deger))
        {
            var deger = kimlikFiltre.Deger.Trim();
            sorgu = kimlikFiltre.Operator switch
            {
                MetinOperatoru.Esittir => sorgu.Where(k => k.KimlikNumarasi == deger),
                MetinOperatoru.BaslarIle => sorgu.Where(k => k.KimlikNumarasi.StartsWith(deger)),
                _ => sorgu.Where(k => k.KimlikNumarasi.Contains(deger))
            };
        }

        if (!string.IsNullOrWhiteSpace(adSoyadFiltre.Deger))
        {
            var deger = adSoyadFiltre.Deger.Trim();
            sorgu = adSoyadFiltre.Operator switch
            {
                MetinOperatoru.Esittir => sorgu.Where(k => k.AdSoyad == deger),
                MetinOperatoru.BaslarIle => sorgu.Where(k => k.AdSoyad.StartsWith(deger)),
                _ => sorgu.Where(k => k.AdSoyad.Contains(deger))
            };
        }

        if (!string.IsNullOrWhiteSpace(firmaFiltre.Deger))
        {
            var deger = firmaFiltre.Deger.Trim();
            sorgu = firmaFiltre.Operator switch
            {
                MetinOperatoru.Esittir => sorgu.Where(k => k.FirmaAdi == deger),
                MetinOperatoru.BaslarIle => sorgu.Where(k => k.FirmaAdi != null && k.FirmaAdi.StartsWith(deger)),
                _ => sorgu.Where(k => k.FirmaAdi != null && k.FirmaAdi.Contains(deger))
            };
        }

        if (!string.IsNullOrWhiteSpace(telefonFiltre.Deger))
        {
            var deger = telefonFiltre.Deger.Trim();
            sorgu = telefonFiltre.Operator switch
            {
                MetinOperatoru.Esittir => sorgu.Where(k => k.Telefon == deger),
                MetinOperatoru.BaslarIle => sorgu.Where(k => k.Telefon != null && k.Telefon.StartsWith(deger)),
                _ => sorgu.Where(k => k.Telefon != null && k.Telefon.Contains(deger))
            };
        }

        var aktifFiltre = SecimToBool(aktifSecim);
        if (aktifFiltre is not null)
        {
            sorgu = sorgu.Where(k => k.Aktif == aktifFiltre);
        }

        if (kvkkOnayDurumuFiltre is not null)
        {
            sorgu = sorgu.Where(k => k.KvkkOnayDurumu == kvkkOnayDurumuFiltre);
        }

        var kvkkOnayFormuAlindiFiltre = SecimToBool(kvkkOnayFormuAlindiSecim);
        if (kvkkOnayFormuAlindiFiltre is not null)
        {
            sorgu = sorgu.Where(k => k.KvkkOnayFormuAlindi == kvkkOnayFormuAlindiFiltre);
        }

        var kaptanFiltre = SecimToBool(kaptanSecim);
        if (kaptanFiltre is not null)
        {
            sorgu = sorgu.Where(k => k.Kaptan == kaptanFiltre);
        }

        var tekneSahibiFiltre = SecimToBool(tekneSahibiSecim);
        if (tekneSahibiFiltre is not null)
        {
            sorgu = sorgu.Where(k => k.TekneSahibi == tekneSahibiFiltre);
        }

        if (kvkkOnayTarihiFiltre.Tarih1 is not null)
        {
            var t1 = kvkkOnayTarihiFiltre.Tarih1.Value.ToDateTime(TimeOnly.MinValue);
            sorgu = kvkkOnayTarihiFiltre.Operator switch
            {
                TarihOperatoru.Once => sorgu.Where(k => k.KvkkOnayTarihi != null && k.KvkkOnayTarihi.Value.Date < t1),
                TarihOperatoru.Sonra => sorgu.Where(k => k.KvkkOnayTarihi != null && k.KvkkOnayTarihi.Value.Date > t1),
                TarihOperatoru.Esittir => sorgu.Where(k => k.KvkkOnayTarihi != null && k.KvkkOnayTarihi.Value.Date == t1),
                TarihOperatoru.Arasi when kvkkOnayTarihiFiltre.Tarih2 is not null =>
                    sorgu.Where(k => k.KvkkOnayTarihi != null
                        && k.KvkkOnayTarihi.Value.Date >= t1
                        && k.KvkkOnayTarihi.Value.Date <= kvkkOnayTarihiFiltre.Tarih2.Value.ToDateTime(TimeOnly.MinValue)),
                _ => sorgu
            };
        }

        sonuclar = await sorgu
            .OrderBy(k => k.AdSoyad)
            .ToListAsync();
    }

    private void FiltreleriTemizle()
    {
        kimlikFiltre = new();
        adSoyadFiltre = new();
        firmaFiltre = new();
        telefonFiltre = new();
        kvkkOnayTarihiFiltre = new();
        aktifSecim = string.Empty;
        kvkkOnayDurumuFiltre = null;
        kvkkOnayFormuAlindiSecim = string.Empty;
        kaptanSecim = string.Empty;
        tekneSahibiSecim = string.Empty;
        sonuclar = null;
    }

    private async Task ExcelAktar()
    {
        if (sonuclar is null || sonuclar.Count == 0)
        {
            return;
        }

        using var workbook = new XLWorkbook();
        var sayfa = workbook.Worksheets.Add("Rapor");

        string[] basliklar =
        [
            "Kimlik No", "Ad Soyad", "Firma Adı", "Telefon", "Aktif",
            "KVKK Onay Durumu", "KVKK Onay Formu Alındı", "KVKK Onay Tarihi", "Kaptan", "Tekne Sahibi"
        ];
        for (var i = 0; i < basliklar.Length; i++)
        {
            sayfa.Cell(1, i + 1).Value = basliklar[i];
            sayfa.Cell(1, i + 1).Style.Font.Bold = true;
        }

        var satir = 2;
        foreach (var kisi in sonuclar)
        {
            sayfa.Cell(satir, 1).Value = kisi.KimlikNumarasi;
            sayfa.Cell(satir, 2).Value = kisi.AdSoyad;
            sayfa.Cell(satir, 3).Value = kisi.FirmaAdi ?? string.Empty;
            sayfa.Cell(satir, 4).Value = kisi.Telefon ?? string.Empty;
            sayfa.Cell(satir, 5).Value = kisi.Aktif ? "Aktif" : "Pasif";
            sayfa.Cell(satir, 6).Value = KvkkOnayDurumuAdi(kisi.KvkkOnayDurumu);
            sayfa.Cell(satir, 7).Value = kisi.KvkkOnayFormuAlindi ? "Evet" : "Hayır";
            sayfa.Cell(satir, 8).Value = KvkkOnayTarihiMetni(kisi);
            sayfa.Cell(satir, 9).Value = kisi.Kaptan ? "Evet" : "Hayır";
            sayfa.Cell(satir, 10).Value = kisi.TekneSahibi ? "Evet" : "Hayır";
            satir++;
        }

        sayfa.Columns().AdjustToContents();

        using var akis = new MemoryStream();
        workbook.SaveAs(akis);
        var base64 = Convert.ToBase64String(akis.ToArray());

        var dosyaAdi = $"KisilerRaporu_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
        await JS.InvokeVoidAsync("dosyaIndir", dosyaAdi, base64,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }
}
