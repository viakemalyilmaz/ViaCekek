@page "/tekneler"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ViaCekek.Web.Data
@using ViaCekek.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Tekne Tanımları</PageTitle>

<h3>Tekne Tanımları</h3>

@if (hataMesaji is not null)
{
    <div class="alert alert-danger">@hataMesaji</div>
}

<button class="btn btn-primary mb-3" @onclick="YeniTekneBaslat">+ Yeni Tekne</button>

@if (formAcik)
{
    <EditForm Model="duzenlenenTekne" OnValidSubmit="Kaydet" class="card card-body mb-3">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-2">
            <label class="form-label">Tekne Kodu</label>
            <InputText class="form-control" @bind-Value="duzenlenenTekne.TekneKodu" />
        </div>
        <div class="mb-2">
            <label class="form-label">Tekne Adı</label>
            <InputText class="form-control" @bind-Value="duzenlenenTekne.TekneAdi" />
        </div>
        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="duzenlenenTekne.Aktif" id="aktifCheck" />
            <label class="form-check-label" for="aktifCheck">Aktif</label>
        </div>

        <div>
            <button type="submit" class="btn btn-success">Kaydet</button>
            <button type="button" class="btn btn-secondary" @onclick="FormuKapat">İptal</button>
        </div>
    </EditForm>
}

@if (tekneler is null)
{
    <p>Yükleniyor...</p>
}
else if (tekneler.Count == 0)
{
    <p>Henüz tekne kaydı yok.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Tekne Kodu</th>
                <th>Tekne Adı</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tekne in tekneler)
            {
                <tr>
                    <td>@tekne.TekneKodu</td>
                    <td>@tekne.TekneAdi</td>
                    <td>
                        @if (tekne.Aktif)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => DuzenlemeBaslat(tekne)">Düzenle</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Tekne>? tekneler;
    private Tekne duzenlenenTekne = new();
    private bool formAcik;
    private string? hataMesaji;

    protected override async Task OnInitializedAsync()
    {
        await ListeyiYenile();
    }

    private async Task ListeyiYenile()
    {
        tekneler = await Db.Tekneler.OrderBy(t => t.TekneKodu).ToListAsync();
    }

    private void YeniTekneBaslat()
    {
        duzenlenenTekne = new Tekne { Aktif = true };
        hataMesaji = null;
        formAcik = true;
    }

    private void DuzenlemeBaslat(Tekne tekne)
    {
        duzenlenenTekne = new Tekne
        {
            Id = tekne.Id,
            TekneKodu = tekne.TekneKodu,
            TekneAdi = tekne.TekneAdi,
            Aktif = tekne.Aktif
        };
        hataMesaji = null;
        formAcik = true;
    }

    private void FormuKapat()
    {
        formAcik = false;
        hataMesaji = null;
    }

    private async Task Kaydet()
    {
        hataMesaji = null;
        try
        {
            if (duzenlenenTekne.Id == 0)
            {
                Db.Tekneler.Add(duzenlenenTekne);
            }
            else
            {
                var mevcut = await Db.Tekneler.FindAsync(duzenlenenTekne.Id);
                if (mevcut is null)
                {
                    hataMesaji = "Kayıt bulunamadı, sayfayı yenileyin.";
                    return;
                }

                mevcut.TekneKodu = duzenlenenTekne.TekneKodu;
                mevcut.TekneAdi = duzenlenenTekne.TekneAdi;
                mevcut.Aktif = duzenlenenTekne.Aktif;
            }

            await Db.SaveChangesAsync();
            formAcik = false;
            await ListeyiYenile();
        }
        catch (DbUpdateException)
        {
            hataMesaji = "Bu tekne kodu zaten kullanılıyor.";
        }
    }
}
