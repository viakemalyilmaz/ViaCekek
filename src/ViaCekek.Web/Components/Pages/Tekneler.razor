@page "/tekneler"
@attribute [Authorize(Roles = $"{Roller.Yonetici},{Roller.SahaKontroloru}")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ViaCekek.Web.Data
@using ViaCekek.Web.Models
@using ViaCekek.Web.Models.Common
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Tekne Tanımları</PageTitle>

<h3>Tekne Tanımları</h3>

@if (hataMesaji is not null)
{
    <div class="alert alert-danger">@hataMesaji</div>
}

<button class="btn btn-lg btn-primary mb-3" @onclick="YeniTekneBaslat">+ Yeni Tekne</button>

@if (formAcik)
{
    <EditForm Model="duzenlenenTekne" OnValidSubmit="Kaydet" class="card card-body mb-3">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-2">
            <label class="form-label">Tekne Kodu</label>
            <input class="form-control" @bind:get="duzenlenenTekne.TekneKodu" @bind:set="v => duzenlenenTekne.TekneKodu = MetinYardimci.BuyukHarf(v)!" @bind:event="oninput" />
        </div>
        <div class="mb-2">
            <label class="form-label">Tekne Adı</label>
            <input class="form-control" @bind:get="duzenlenenTekne.TekneAdi" @bind:set="v => duzenlenenTekne.TekneAdi = MetinYardimci.BuyukHarf(v)!" @bind:event="oninput" />
        </div>
        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="duzenlenenTekne.Aktif" id="aktifCheck" />
            <label class="form-check-label" for="aktifCheck">Aktif</label>
        </div>

        <div>
            <button type="submit" class="btn btn-lg btn-success">Kaydet</button>
            <button type="button" class="btn btn-lg btn-secondary" @onclick="FormuKapat">Kapat</button>
        </div>
    </EditForm>
}

@if (!formAcik)
{
    <div class="mb-3">
        <input type="search" class="form-control" style="max-width: 400px;"
               placeholder="Aramak için yazın (tekne kodu, tekne adı)..."
               @bind:get="aramaMetni" @bind:set="AramaDegisti" @bind:event="oninput" autocomplete="off" />
    </div>

    @if (aramaSonuclari is null)
    {
        <p>Aramak için yukarıya yazın.</p>
    }
    else if (aramaSonuclari.Count == 0)
    {
        <p>Aramanızla eşleşen kayıt bulunamadı.</p>
    }
    else
    {
    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th role="button" class="text-nowrap" @onclick='() => SiralamayiDegistir("TekneKodu")'>Tekne Kodu @SiralamaIsareti("TekneKodu")</th>
                <th role="button" class="text-nowrap" @onclick='() => SiralamayiDegistir("TekneAdi")'>Tekne Adı @SiralamaIsareti("TekneAdi")</th>
                <th role="button" class="text-nowrap" @onclick='() => SiralamayiDegistir("Durum")'>Durum @SiralamaIsareti("Durum")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tekne in aramaSonuclari)
            {
                <tr>
                    <td>@tekne.TekneKodu</td>
                    <td>@tekne.TekneAdi</td>
                    <td>
                        @if (tekne.Aktif)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-outline-primary" @onclick="() => DuzenlemeBaslat(tekne)">Düzenle</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (aramaSonuclari.Count == AramaSonucLimiti)
    {
        <p class="text-muted">İlk @AramaSonucLimiti sonuç gösteriliyor — daha spesifik arayın.</p>
    }
    }
}

@code {
    // Bkz. Kisiler.razor'daki aynı not: büyük tabloda tam liste yüklemesi
    // yerine arama-öncelikli, sunucu tarafı debounce'lu sorgu deseni.
    private const int AramaSonucLimiti = 50;

    private Tekne duzenlenenTekne = new();
    private bool formAcik;
    private string? hataMesaji;

    private string aramaMetni = string.Empty;
    private List<Tekne>? aramaSonuclari;
    private CancellationTokenSource? aramaCts;
    private string siralamaAlani = "TekneKodu";
    private bool siralamaArtan = true;

    private IQueryable<Tekne> AramaSorgusu(ApplicationDbContext db, string arama)
    {
        var sorgu = db.Tekneler.AsNoTracking().Where(t =>
            t.TekneKodu.Contains(arama) || t.TekneAdi.Contains(arama));

        return siralamaAlani switch
        {
            "TekneAdi" => siralamaArtan ? sorgu.OrderBy(t => t.TekneAdi) : sorgu.OrderByDescending(t => t.TekneAdi),
            "Durum" => siralamaArtan ? sorgu.OrderBy(t => t.Aktif) : sorgu.OrderByDescending(t => t.Aktif),
            _ => siralamaArtan ? sorgu.OrderBy(t => t.TekneKodu) : sorgu.OrderByDescending(t => t.TekneKodu),
        };
    }

    private async Task AramaDegisti(string? v)
    {
        aramaMetni = v ?? string.Empty;

        aramaCts?.Cancel();
        var cts = new CancellationTokenSource();
        aramaCts = cts;

        var arama = aramaMetni.Trim();
        if (string.IsNullOrEmpty(arama))
        {
            aramaSonuclari = null;
            return;
        }

        try
        {
            await Task.Delay(250, cts.Token);
            await using var db = await DbFactory.CreateDbContextAsync(cts.Token);
            aramaSonuclari = await AramaSorgusu(db, arama).Take(AramaSonucLimiti).ToListAsync(cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Kullanıcı yazmaya devam etti, bu arama artık geçersiz.
        }
    }

    private async Task AramaSonuclariniYenile()
    {
        var arama = aramaMetni.Trim();
        if (string.IsNullOrEmpty(arama))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        aramaSonuclari = await AramaSorgusu(db, arama).Take(AramaSonucLimiti).ToListAsync();
    }

    private async Task SiralamayiDegistir(string alan)
    {
        if (siralamaAlani == alan)
        {
            siralamaArtan = !siralamaArtan;
        }
        else
        {
            siralamaAlani = alan;
            siralamaArtan = true;
        }

        await AramaSonuclariniYenile();
    }

    private string SiralamaIsareti(string alan) => siralamaAlani != alan ? "" : (siralamaArtan ? "▲" : "▼");

    private async Task<string?> AktifKullaniciAdi()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        return authState.User?.Identity?.Name;
    }

    private void YeniTekneBaslat()
    {
        duzenlenenTekne = new Tekne { Aktif = true };
        hataMesaji = null;
        formAcik = true;
    }

    private void DuzenlemeBaslat(Tekne tekne)
    {
        duzenlenenTekne = new Tekne
        {
            Id = tekne.Id,
            TekneKodu = tekne.TekneKodu,
            TekneAdi = tekne.TekneAdi,
            Aktif = tekne.Aktif
        };
        hataMesaji = null;
        formAcik = true;
    }

    private void FormuKapat()
    {
        formAcik = false;
        hataMesaji = null;
    }

    private async Task Kaydet()
    {
        hataMesaji = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (duzenlenenTekne.Id == 0)
            {
                db.Tekneler.Add(duzenlenenTekne);
            }
            else
            {
                var mevcut = await db.Tekneler.FindAsync(duzenlenenTekne.Id);
                if (mevcut is null)
                {
                    hataMesaji = "Kayıt bulunamadı, sayfayı yenileyin.";
                    return;
                }

                mevcut.TekneKodu = duzenlenenTekne.TekneKodu;
                mevcut.TekneAdi = duzenlenenTekne.TekneAdi;
                mevcut.Aktif = duzenlenenTekne.Aktif;
            }

            db.MevcutKullanici = await AktifKullaniciAdi();
            await db.SaveChangesAsync();
            formAcik = false;
            await AramaSonuclariniYenile();
        }
        catch (DbUpdateException)
        {
            hataMesaji = "Bu tekne kodu zaten kullanılıyor.";
        }
    }
}
