@page "/araclar"
@attribute [Authorize(Roles = $"{Roller.Yonetici},{Roller.SahaKontroloru},{Roller.Guvenlik}")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ViaCekek.Web.Data
@using ViaCekek.Web.Models
@using ViaCekek.Web.Models.Common
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Araç Tanımları</PageTitle>

<div class="araclar-page @(formAcik ? "form-open" : null)">

<h3>Araç Tanımları</h3>

@if (hataMesaji is not null)
{
    <div class="alert alert-danger">@hataMesaji</div>
}

@if (!formAcik)
{
    <button class="btn btn-lg btn-primary mb-3" @onclick="YeniAracBaslat">+ Yeni Araç</button>
}

@if (formAcik)
{
    <EditForm Model="duzenlenenArac" OnValidSubmit="Kaydet" class="form-scroll-layout">
        <DataAnnotationsValidator />

        <div class="form-sticky-actions">
            <button type="submit" class="btn btn-lg btn-success">Kaydet</button>
            <button type="button" class="btn btn-lg btn-secondary" @onclick="FormuKapat">Kapat</button>
            @if (basariMesaji is not null)
            {
                <div class="alert @(basariUyariMi ? "alert-warning" : "alert-success") mt-2 mb-0">@basariMesaji</div>
            }
        </div>

        <div class="form-scroll-content">
            <div class="card card-body">
        <ValidationSummary />

        <div class="row">
            <div class="col-md-4 mb-2">
                <label class="form-label">Takip Numarası</label>
                <input class="form-control" @bind:get="duzenlenenArac.TakipNumarasi" @bind:set="TakipNumarasiInputDegisti" @bind:event="oninput" autocomplete="off" />
                @if (duzenlenenArac.Id == 0 && eslesenAraclarForm.Count > 0)
                {
                    <div class="list-group mt-1">
                        @foreach (var eslesen in eslesenAraclarForm)
                        {
                            <button type="button" class="list-group-item list-group-item-action py-1" @onclick="() => DuzenlemeBaslat(eslesen)">
                                <strong>@eslesen.TakipNumarasi</strong> — @AracTuruAdi(eslesen.AracTuru)
                                @if (!eslesen.Aktif)
                                {
                                    <span class="badge bg-secondary ms-1">Pasif</span>
                                }
                            </button>
                        }
                    </div>
                    <div class="form-text">Bu takip numarasıyla kayıt zaten var — üzerine tıklayarak düzenleyebilirsin.</div>
                }
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">Araç Türü</label>
                <InputSelect class="form-select" @bind-Value="duzenlenenArac.AracTuru" @bind-Value:after="AracTuruDegisti">
                    <option value="@AracTuru.Arac">Araç</option>
                    <option value="@AracTuru.Vinc">Vinç</option>
                    <option value="@AracTuru.Vidanjor">Vidanjör</option>
                    <option value="@AracTuru.Kompresor">Kompresör</option>
                    <option value="@AracTuru.BasincliKap">Basınçlı Kap</option>
                </InputSelect>
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">Firma Adı</label>
                <input class="form-control" list="firmaListesi" @bind:get="duzenlenenArac.FirmaAdi" @bind:set="v => duzenlenenArac.FirmaAdi = MetinYardimci.BuyukHarf(v)" @bind:event="oninput" />
                <datalist id="firmaListesi">
                    @foreach (var firma in firmaOnerileri)
                    {
                        <option value="@firma" />
                    }
                </datalist>
            </div>
        </div>

        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="duzenlenenArac.Aktif" id="aktifCheck" />
            <label class="form-check-label" for="aktifCheck">Aktif</label>
        </div>

        @if (!duzenlenenArac.Aktif)
        {
            <div class="mb-3">
                <label class="form-label">Yasaklanma Sebebi</label>
                <input class="form-control" @bind:get="duzenlenenArac.YasaklanmaSebebi" @bind:set="v => duzenlenenArac.YasaklanmaSebebi = MetinYardimci.BuyukHarf(v)" @bind:event="oninput" />
            </div>
        }

        @if (belgeDurumSatirlari is not null)
        {
            <p class="text-muted mb-2">@AracTuruAdi(duzenlenenArac.AracTuru) için geçerli belgeler:</p>
            @if (belgeDurumSatirlari.Count == 0)
            {
                <p class="text-muted">Bu araç türü için tanımlı belge yok.</p>
            }
            else
            {
                <div class="table-responsive mb-3">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Belge</th>
                            <th>Alındı</th>
                            <th>Detay</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var satir in belgeDurumSatirlari)
                        {
                            <tr>
                                <td>@satir.Belge.BelgeTanimi</td>
                                <td>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="belge-alindi-@satir.Belge.Id" @bind="satir.Alindi" />
                                        <label class="form-check-label" for="belge-alindi-@satir.Belge.Id">Alındı</label>
                                    </div>
                                </td>
                                <td>
                                    @if (satir.Belge.GecerlilikTarihiKontrolu)
                                    {
                                        <input type="date" class="form-control" style="width: auto; display: inline-block;" disabled="@(!satir.Alindi)" @bind="satir.GecerlilikTarihi" />
                                        @if (satir.GecerlilikTarihi is not null && satir.GecerlilikTarihi.Value.Date < DateTime.Today)
                                        {
                                            <span class="badge bg-danger ms-2">Süresi geçmiş</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        }
            </div>
        </div>
    </EditForm>
}

@if (!formAcik)
{
    <div class="mb-3">
        <input type="search" class="form-control" style="max-width: 400px;"
               placeholder="Aramak için yazın (takip no, araç türü, firma)..."
               @bind:get="aramaMetni" @bind:set="AramaDegisti" @bind:event="oninput" autocomplete="off" />
    </div>

    @if (aramaSonuclari is null)
    {
        <p>Aramak için yukarıya yazın.</p>
    }
    else if (aramaSonuclari.Count == 0)
    {
        <p>Aramanızla eşleşen kayıt bulunamadı.</p>
    }
    else
    {
    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th role="button" class="text-nowrap" @onclick='() => SiralamayiDegistir("TakipNumarasi")'>Takip Numarası @SiralamaIsareti("TakipNumarasi")</th>
                <th role="button" class="text-nowrap" @onclick='() => SiralamayiDegistir("AracTuru")'>Araç Türü @SiralamaIsareti("AracTuru")</th>
                <th role="button" class="text-nowrap" @onclick='() => SiralamayiDegistir("FirmaAdi")'>Firma @SiralamaIsareti("FirmaAdi")</th>
                <th role="button" class="text-nowrap" @onclick='() => SiralamayiDegistir("Durum")'>Durum @SiralamaIsareti("Durum")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var arac in aramaSonuclari)
            {
                <tr>
                    <td>@arac.TakipNumarasi</td>
                    <td>@AracTuruAdi(arac.AracTuru)</td>
                    <td>@arac.FirmaAdi</td>
                    <td>
                        @if (arac.Aktif)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                        @if (!string.IsNullOrEmpty(arac.YasaklanmaSebebi))
                        {
                            <span class="badge bg-danger ms-1" title="@arac.YasaklanmaSebebi">Yasaklı</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-outline-primary" @onclick="() => DuzenlemeBaslat(arac)">Düzenle</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (aramaSonuclari.Count == AramaSonucLimiti)
    {
        <p class="text-muted">İlk @AramaSonucLimiti sonuç gösteriliyor — daha spesifik arayın.</p>
    }
    }
}

</div>

@code {
    // Bkz. Kisiler.razor'daki aynı not: büyük tabloda tam liste yüklemesi
    // yerine arama-öncelikli, sunucu tarafı debounce'lu sorgu deseni.
    private const int AramaSonucLimiti = 50;

    private List<string> firmaOnerileri = [];
    private Arac duzenlenenArac = new();
    private bool formAcik;
    private string? hataMesaji;
    private string? basariMesaji;
    private bool basariUyariMi;

    private string aramaMetni = string.Empty;
    private List<Arac>? aramaSonuclari;
    private CancellationTokenSource? aramaCts;
    private string siralamaAlani = "TakipNumarasi";
    private bool siralamaArtan = true;

    private List<Arac> eslesenAraclarForm = [];
    private CancellationTokenSource? takipAramaCts;

    private IQueryable<Arac> AramaSorgusu(ApplicationDbContext db, string arama)
    {
        // Araç türü Türkçe adıyla da aranabilsin diye her tür için ayrı bir
        // bool önceden hesaplanıyor (AracTuruAdi() bir C# metodu, doğrudan
        // SQL'e çevrilemiyor). Bilerek List<AracTuru>.Contains(...) KULLANILMIYOR
        // — EF Core 8 bunu OPENJSON'a çeviriyor, gerçek sunucu SQL Server 2014
        // olduğu için OPENJSON desteklemiyor ve sorgu her seferinde
        // "Incorrect syntax near the keyword 'WITH'" ile çöküyordu (gerçek DB'ye
        // karşı doğrulanan bir bug, 2026-08-25). Tek tek eşitlik kontrolü hem
        // basit SQL üretiyor hem 5 sabit türde performans sorunu yaratmıyor.
        var aracEslesir = AracTuruAdi(AracTuru.Arac).Contains(arama, StringComparison.OrdinalIgnoreCase);
        var vincEslesir = AracTuruAdi(AracTuru.Vinc).Contains(arama, StringComparison.OrdinalIgnoreCase);
        var vidanjorEslesir = AracTuruAdi(AracTuru.Vidanjor).Contains(arama, StringComparison.OrdinalIgnoreCase);
        var kompresorEslesir = AracTuruAdi(AracTuru.Kompresor).Contains(arama, StringComparison.OrdinalIgnoreCase);
        var basincliKapEslesir = AracTuruAdi(AracTuru.BasincliKap).Contains(arama, StringComparison.OrdinalIgnoreCase);

        var sorgu = db.Araclar.AsNoTracking().Where(a =>
            a.TakipNumarasi.Contains(arama) ||
            (a.FirmaAdi != null && a.FirmaAdi.Contains(arama)) ||
            (aracEslesir && a.AracTuru == AracTuru.Arac) ||
            (vincEslesir && a.AracTuru == AracTuru.Vinc) ||
            (vidanjorEslesir && a.AracTuru == AracTuru.Vidanjor) ||
            (kompresorEslesir && a.AracTuru == AracTuru.Kompresor) ||
            (basincliKapEslesir && a.AracTuru == AracTuru.BasincliKap));

        return siralamaAlani switch
        {
            "AracTuru" => siralamaArtan ? sorgu.OrderBy(a => a.AracTuru) : sorgu.OrderByDescending(a => a.AracTuru),
            "FirmaAdi" => siralamaArtan ? sorgu.OrderBy(a => a.FirmaAdi) : sorgu.OrderByDescending(a => a.FirmaAdi),
            "Durum" => siralamaArtan ? sorgu.OrderBy(a => a.Aktif) : sorgu.OrderByDescending(a => a.Aktif),
            _ => siralamaArtan ? sorgu.OrderBy(a => a.TakipNumarasi) : sorgu.OrderByDescending(a => a.TakipNumarasi),
        };
    }

    private async Task AramaDegisti(string? v)
    {
        aramaMetni = v ?? string.Empty;

        aramaCts?.Cancel();
        var cts = new CancellationTokenSource();
        aramaCts = cts;

        var arama = aramaMetni.Trim();
        if (string.IsNullOrEmpty(arama))
        {
            aramaSonuclari = null;
            return;
        }

        try
        {
            await Task.Delay(250, cts.Token);
            await using var db = await DbFactory.CreateDbContextAsync(cts.Token);
            aramaSonuclari = await AramaSorgusu(db, arama).Take(AramaSonucLimiti).ToListAsync(cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Kullanıcı yazmaya devam etti, bu arama artık geçersiz.
        }
    }

    private async Task AramaSonuclariniYenile()
    {
        var arama = aramaMetni.Trim();
        if (string.IsNullOrEmpty(arama))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        aramaSonuclari = await AramaSorgusu(db, arama).Take(AramaSonucLimiti).ToListAsync();
    }

    private async Task SiralamayiDegistir(string alan)
    {
        if (siralamaAlani == alan)
        {
            siralamaArtan = !siralamaArtan;
        }
        else
        {
            siralamaAlani = alan;
            siralamaArtan = true;
        }

        await AramaSonuclariniYenile();
    }

    private string SiralamaIsareti(string alan) => siralamaAlani != alan ? "" : (siralamaArtan ? "▲" : "▼");

    private async Task TakipNumarasiInputDegisti(string? v)
    {
        duzenlenenArac.TakipNumarasi = MetinYardimci.BuyukHarf(v)!;

        takipAramaCts?.Cancel();

        if (duzenlenenArac.Id != 0)
        {
            eslesenAraclarForm = [];
            return;
        }

        var cts = new CancellationTokenSource();
        takipAramaCts = cts;

        var arama = duzenlenenArac.TakipNumarasi.Trim();
        if (string.IsNullOrEmpty(arama))
        {
            eslesenAraclarForm = [];
            return;
        }

        try
        {
            await Task.Delay(200, cts.Token);
            await using var db = await DbFactory.CreateDbContextAsync(cts.Token);
            eslesenAraclarForm = await db.Araclar.AsNoTracking()
                .Where(a => a.TakipNumarasi.Contains(arama))
                .OrderBy(a => a.TakipNumarasi)
                .Take(5)
                .ToListAsync(cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Kullanıcı yazmaya devam etti, bu arama artık geçersiz.
        }
    }

    private List<BelgeDurumSatiri>? belgeDurumSatirlari;

    private sealed class BelgeDurumSatiri
    {
        public AracBelge Belge { get; set; } = null!;
        public bool Alindi { get; set; }
        public DateTime? GecerlilikTarihi { get; set; }
    }

    [SupplyParameterFromQuery(Name = "duzenle")]
    public int? SorguDuzenleId { get; set; }

    [SupplyParameterFromQuery(Name = "yeniTakip")]
    public string? SorguYeniTakip { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await FirmaOnerileriYukle();

        if (SorguDuzenleId is int id)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var arac = await db.Araclar.AsNoTracking().FirstOrDefaultAsync(a => a.Id == id);
            if (arac is not null)
            {
                await DuzenlemeBaslat(arac);
            }
        }
        else if (!string.IsNullOrWhiteSpace(SorguYeniTakip))
        {
            await YeniAracBaslat();
            duzenlenenArac.TakipNumarasi = SorguYeniTakip;
        }
    }

    private async Task<string?> AktifKullaniciAdi()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        return authState.User?.Identity?.Name;
    }

    private async Task FirmaOnerileriYukle()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        firmaOnerileri = await db.Araclar
            .Where(a => a.FirmaAdi != null && a.FirmaAdi != "")
            .Select(a => a.FirmaAdi!)
            .Distinct()
            .OrderBy(f => f)
            .ToListAsync();
    }

    private static string AracTuruAdi(AracTuru tur) => tur switch
    {
        AracTuru.Arac => "Araç",
        AracTuru.Vinc => "Vinç",
        AracTuru.Vidanjor => "Vidanjör",
        AracTuru.Kompresor => "Kompresör",
        AracTuru.BasincliKap => "Basınçlı Kap",
        _ => tur.ToString()
    };

    private async Task YeniAracBaslat()
    {
        duzenlenenArac = new Arac { Aktif = true };
        eslesenAraclarForm = [];
        takipAramaCts?.Cancel();
        hataMesaji = null;
        basariMesaji = null;
        formAcik = true;
        await BelgeDurumlariniYukle(null, duzenlenenArac.AracTuru);
    }

    private async Task DuzenlemeBaslat(Arac arac)
    {
        eslesenAraclarForm = [];
        takipAramaCts?.Cancel();
        duzenlenenArac = new Arac
        {
            Id = arac.Id,
            TakipNumarasi = arac.TakipNumarasi,
            AracTuru = arac.AracTuru,
            FirmaAdi = arac.FirmaAdi,
            Aktif = arac.Aktif,
            YasaklanmaSebebi = arac.YasaklanmaSebebi
        };
        hataMesaji = null;
        basariMesaji = null;
        formAcik = true;
        await BelgeDurumlariniYukle(arac.Id, arac.AracTuru);
    }

    private void FormuKapat()
    {
        formAcik = false;
        hataMesaji = null;
        belgeDurumSatirlari = null;
    }

    private async Task AracTuruDegisti()
    {
        var aracId = duzenlenenArac.Id == 0 ? (int?)null : duzenlenenArac.Id;
        await BelgeDurumlariniYukle(aracId, duzenlenenArac.AracTuru);
    }

    private async Task BelgeDurumlariniYukle(int? aracId, AracTuru aracTuru)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        IQueryable<AracBelge> sorgu = db.AracBelgeleri.Where(b => b.Aktif);
        sorgu = aracTuru switch
        {
            AracTuru.Arac => sorgu.Where(b => b.GecerliArac),
            AracTuru.Vinc => sorgu.Where(b => b.GecerliVinc),
            AracTuru.Vidanjor => sorgu.Where(b => b.GecerliVidanjor),
            AracTuru.Kompresor => sorgu.Where(b => b.GecerliKompresor),
            AracTuru.BasincliKap => sorgu.Where(b => b.GecerliBasincliKap),
            _ => sorgu
        };
        var kurallar = await sorgu.OrderBy(b => b.BelgeTanimi).ToListAsync();

        var mevcutDurumlar = aracId is int id
            ? await db.AracBelgeKontrolleri.Where(k => k.AracId == id).ToListAsync()
            : [];

        belgeDurumSatirlari = kurallar.Select(kural =>
        {
            var mevcut = mevcutDurumlar.FirstOrDefault(d => d.AracBelgeId == kural.Id);
            return new BelgeDurumSatiri
            {
                Belge = kural,
                Alindi = mevcut?.AlindiSonucu ?? false,
                GecerlilikTarihi = mevcut?.GecerlilikTarihiSonucu
            };
        }).ToList();
    }

    private async Task Kaydet()
    {
        hataMesaji = null;
        basariMesaji = null;

        // Yasaklanma Sebebi yalnızca Pasif araçlarda tutulur (bkz. CK_Araclar_YasaklanmaSebebi_Aktif).
        if (duzenlenenArac.Aktif)
        {
            duzenlenenArac.YasaklanmaSebebi = null;
        }

        // Alındı işaretli değilse tarih anlamsızdır, temizlenir ve kullanıcı uyarılır.
        var uyariBelgeleri = new List<string>();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            Arac arac;
            var yeniKayit = duzenlenenArac.Id == 0;

            if (yeniKayit)
            {
                arac = duzenlenenArac;
                db.Araclar.Add(arac);
            }
            else
            {
                var mevcut = await db.Araclar.FindAsync(duzenlenenArac.Id);
                if (mevcut is null)
                {
                    hataMesaji = "Kayıt bulunamadı, sayfayı yenileyin.";
                    return;
                }

                mevcut.TakipNumarasi = duzenlenenArac.TakipNumarasi;
                mevcut.AracTuru = duzenlenenArac.AracTuru;
                mevcut.FirmaAdi = duzenlenenArac.FirmaAdi;
                mevcut.Aktif = duzenlenenArac.Aktif;
                mevcut.YasaklanmaSebebi = duzenlenenArac.YasaklanmaSebebi;
                arac = mevcut;
            }

            if (belgeDurumSatirlari is not null)
            {
                foreach (var satir in belgeDurumSatirlari)
                {
                    if (!satir.Alindi && satir.GecerlilikTarihi is not null)
                    {
                        uyariBelgeleri.Add(satir.Belge.BelgeTanimi);
                        satir.GecerlilikTarihi = null;
                    }

                    var gecerlilikTarihi = satir.Belge.GecerlilikTarihiKontrolu ? satir.GecerlilikTarihi : null;

                    var mevcutKontrol = yeniKayit
                        ? null
                        : await db.AracBelgeKontrolleri
                            .FirstOrDefaultAsync(k => k.AracId == arac.Id && k.AracBelgeId == satir.Belge.Id);

                    if (mevcutKontrol is null)
                    {
                        var yeniKontrol = new AracBelgeKontrol
                        {
                            AracBelgeId = satir.Belge.Id,
                            AlindiSonucu = satir.Alindi,
                            GecerlilikTarihiSonucu = gecerlilikTarihi
                        };

                        // Yeni araç için Id henüz atanmadı (SaveChanges'ten sonra
                        // atanır) — navigation ile ilişki kurulur, EF Core FK'yı
                        // otomatik doldurur.
                        if (yeniKayit)
                        {
                            yeniKontrol.Arac = arac;
                        }
                        else
                        {
                            yeniKontrol.AracId = arac.Id;
                        }

                        db.AracBelgeKontrolleri.Add(yeniKontrol);
                    }
                    else
                    {
                        mevcutKontrol.AlindiSonucu = satir.Alindi;
                        mevcutKontrol.GecerlilikTarihiSonucu = gecerlilikTarihi;
                    }
                }
            }

            db.MevcutKullanici = await AktifKullaniciAdi();
            await db.SaveChangesAsync();
            await FirmaOnerileriYukle();
            await AramaSonuclariniYenile();

            basariUyariMi = uyariBelgeleri.Count > 0;
            var mesaj = basariUyariMi
                ? $"Kaydedildi. Alındı işaretli olmadığı için şu belgelerin tarihi boş kaydedildi: {string.Join(", ", uyariBelgeleri)}."
                : "Kaydedildi.";

            if (yeniKayit)
            {
                // Yeni kayıt butonuna basılmış gibi ekran temizlenir — art
                // arda hızlı veri girişine izin vermek için.
                duzenlenenArac = new Arac { Aktif = true };
                eslesenAraclarForm = [];
                takipAramaCts?.Cancel();
                await BelgeDurumlariniYukle(null, duzenlenenArac.AracTuru);
            }
            else
            {
                // Düzenleme modunda aynı kayıt üzerinde kalınır.
                await DuzenlemeBaslat(arac);
            }
            basariMesaji = mesaj;
        }
        catch (DbUpdateException)
        {
            hataMesaji = "Bu takip numarası zaten kayıtlı.";
        }
    }
}
