@page "/araclar"
@attribute [Authorize(Roles = $"{Roller.Yonetici},{Roller.SahaKontroloru}")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ViaCekek.Web.Data
@using ViaCekek.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Araç Tanımları</PageTitle>

<h3>Araç Tanımları</h3>

@if (hataMesaji is not null)
{
    <div class="alert alert-danger">@hataMesaji</div>
}

<button class="btn btn-lg btn-primary mb-3" @onclick="YeniAracBaslat">+ Yeni Araç</button>

@if (formAcik)
{
    <EditForm Model="duzenlenenArac" OnValidSubmit="Kaydet" class="card card-body mb-3">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row">
            <div class="col-md-4 mb-2">
                <label class="form-label">Takip Numarası</label>
                <InputText class="form-control" @bind-Value="duzenlenenArac.TakipNumarasi" />
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">Araç Türü</label>
                <InputSelect class="form-select" @bind-Value="duzenlenenArac.AracTuru">
                    <option value="@AracTuru.Arac">Araç</option>
                    <option value="@AracTuru.Vinc">Vinç</option>
                    <option value="@AracTuru.Vidanjor">Vidanjör</option>
                    <option value="@AracTuru.Kompresor">Kompresör</option>
                    <option value="@AracTuru.BasincliKap">Basınçlı Kap</option>
                </InputSelect>
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">Firma Adı</label>
                <input class="form-control" list="firmaListesi" @bind="duzenlenenArac.FirmaAdi" />
                <datalist id="firmaListesi">
                    @foreach (var firma in firmaOnerileri)
                    {
                        <option value="@firma" />
                    }
                </datalist>
            </div>
        </div>

        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="duzenlenenArac.Aktif" id="aktifCheck" />
            <label class="form-check-label" for="aktifCheck">Aktif</label>
        </div>

        @if (!duzenlenenArac.Aktif)
        {
            <div class="mb-3">
                <label class="form-label">Yasaklanma Sebebi</label>
                <InputText class="form-control" @bind-Value="duzenlenenArac.YasaklanmaSebebi" />
            </div>
        }

        <div>
            <button type="submit" class="btn btn-lg btn-success">Kaydet</button>
            <button type="button" class="btn btn-lg btn-secondary" @onclick="FormuKapat">İptal</button>
        </div>
    </EditForm>
}

@if (araclar is null)
{
    <p>Yükleniyor...</p>
}
else if (araclar.Count == 0)
{
    <p>Henüz araç kaydı yok.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Takip Numarası</th>
                <th>Araç Türü</th>
                <th>Firma</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var arac in araclar)
            {
                <tr>
                    <td>@arac.TakipNumarasi</td>
                    <td>@AracTuruAdi(arac.AracTuru)</td>
                    <td>@arac.FirmaAdi</td>
                    <td>
                        @if (arac.Aktif)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                        @if (!string.IsNullOrEmpty(arac.YasaklanmaSebebi))
                        {
                            <span class="badge bg-danger ms-1" title="@arac.YasaklanmaSebebi">Yasaklı</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-outline-primary" @onclick="() => DuzenlemeBaslat(arac)">Düzenle</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private List<Arac>? araclar;
    private List<string> firmaOnerileri = [];
    private Arac duzenlenenArac = new();
    private bool formAcik;
    private string? hataMesaji;

    protected override async Task OnInitializedAsync()
    {
        await ListeyiYenile();
    }

    private async Task ListeyiYenile()
    {
        araclar = await Db.Araclar.OrderBy(a => a.TakipNumarasi).ToListAsync();
        firmaOnerileri = await Db.Araclar
            .Where(a => a.FirmaAdi != null && a.FirmaAdi != "")
            .Select(a => a.FirmaAdi!)
            .Distinct()
            .OrderBy(f => f)
            .ToListAsync();
    }

    private static string AracTuruAdi(AracTuru tur) => tur switch
    {
        AracTuru.Arac => "Araç",
        AracTuru.Vinc => "Vinç",
        AracTuru.Vidanjor => "Vidanjör",
        AracTuru.Kompresor => "Kompresör",
        AracTuru.BasincliKap => "Basınçlı Kap",
        _ => tur.ToString()
    };

    private void YeniAracBaslat()
    {
        duzenlenenArac = new Arac { Aktif = true };
        hataMesaji = null;
        formAcik = true;
    }

    private void DuzenlemeBaslat(Arac arac)
    {
        duzenlenenArac = new Arac
        {
            Id = arac.Id,
            TakipNumarasi = arac.TakipNumarasi,
            AracTuru = arac.AracTuru,
            FirmaAdi = arac.FirmaAdi,
            Aktif = arac.Aktif,
            YasaklanmaSebebi = arac.YasaklanmaSebebi
        };
        hataMesaji = null;
        formAcik = true;
    }

    private void FormuKapat()
    {
        formAcik = false;
        hataMesaji = null;
    }

    private async Task Kaydet()
    {
        hataMesaji = null;

        // Yasaklanma Sebebi yalnızca Pasif araçlarda tutulur (bkz. CK_Araclar_YasaklanmaSebebi_Aktif).
        if (duzenlenenArac.Aktif)
        {
            duzenlenenArac.YasaklanmaSebebi = null;
        }

        try
        {
            if (duzenlenenArac.Id == 0)
            {
                Db.Araclar.Add(duzenlenenArac);
            }
            else
            {
                var mevcut = await Db.Araclar.FindAsync(duzenlenenArac.Id);
                if (mevcut is null)
                {
                    hataMesaji = "Kayıt bulunamadı, sayfayı yenileyin.";
                    return;
                }

                mevcut.TakipNumarasi = duzenlenenArac.TakipNumarasi;
                mevcut.AracTuru = duzenlenenArac.AracTuru;
                mevcut.FirmaAdi = duzenlenenArac.FirmaAdi;
                mevcut.Aktif = duzenlenenArac.Aktif;
                mevcut.YasaklanmaSebebi = duzenlenenArac.YasaklanmaSebebi;
            }

            await Db.SaveChangesAsync();
            formAcik = false;
            await ListeyiYenile();
        }
        catch (DbUpdateException)
        {
            hataMesaji = "Bu takip numarası zaten kayıtlı.";
        }
    }
}
