@page "/kisiler"
@attribute [Authorize(Roles = $"{Roller.Yonetici},{Roller.SahaKontroloru},{Roller.Guvenlik}")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ViaCekek.Web.Data
@using ViaCekek.Web.Models
@using ViaCekek.Web.Models.Common
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Kişi Tanımları</PageTitle>

<div class="kisiler-page @(formAcik ? "form-open" : null)">

<h3>Kişi Tanımları</h3>

@if (hataMesaji is not null)
{
    <div class="alert alert-danger">@hataMesaji</div>
}

@if (!formAcik)
{
    <button class="btn btn-lg btn-primary mb-3" @onclick="YeniKisiBaslat">+ Yeni Kişi</button>
}

@if (formAcik)
{
    <EditForm Model="duzenlenenKisi" OnValidSubmit="Kaydet" class="form-scroll-layout">
        <DataAnnotationsValidator />

        <div class="form-sticky-actions">
            <button type="submit" class="btn btn-lg btn-success">Kaydet</button>
            <button type="button" class="btn btn-lg btn-secondary" @onclick="FormuKapat">Kapat</button>
            @if (basariMesaji is not null)
            {
                <div class="alert @(basariUyariMi ? "alert-warning" : "alert-success") mt-2 mb-0">@basariMesaji</div>
            }
        </div>

        <div class="form-scroll-content">
            <div class="card card-body">
        <ValidationSummary />

        <div class="row">
            <div class="col-md-4 mb-2">
                <label class="form-label">Kimlik Numarası</label>
                <input class="form-control" @bind:get="duzenlenenKisi.KimlikNumarasi" @bind:set="KimlikNumarasiInputDegisti" @bind:event="oninput" autocomplete="off" />
                @if (duzenlenenKisi.Id == 0 && eslesenKisilerForm.Count > 0)
                {
                    <div class="list-group mt-1">
                        @foreach (var eslesen in eslesenKisilerForm)
                        {
                            <button type="button" class="list-group-item list-group-item-action py-1" @onclick="() => DuzenlemeBaslat(eslesen)">
                                <strong>@eslesen.KimlikNumarasi</strong> — @eslesen.AdSoyad
                                @if (!eslesen.Aktif)
                                {
                                    <span class="badge bg-secondary ms-1">Pasif</span>
                                }
                            </button>
                        }
                    </div>
                    <div class="form-text">Bu kimlik numarasıyla kayıt zaten var — üzerine tıklayarak düzenleyebilirsin.</div>
                }
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">Ad Soyad</label>
                <input class="form-control" @bind:get="duzenlenenKisi.AdSoyad" @bind:set="v => duzenlenenKisi.AdSoyad = MetinYardimci.BuyukHarf(v)!" @bind:event="oninput" />
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">Telefon</label>
                <InputText class="form-control" @bind-Value="duzenlenenKisi.Telefon" placeholder="5XXXXXXXXX" />
            </div>
        </div>

        <div class="mb-2">
            <label class="form-label">Firma Adı</label>
            <input class="form-control" list="firmaListesi" @bind:get="duzenlenenKisi.FirmaAdi" @bind:set="v => duzenlenenKisi.FirmaAdi = MetinYardimci.BuyukHarf(v)" @bind:event="oninput" />
            <datalist id="firmaListesi">
                @foreach (var firma in firmaOnerileri)
                {
                    <option value="@firma" />
                }
            </datalist>
        </div>

        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="duzenlenenKisi.Aktif" id="aktifCheck" />
            <label class="form-check-label" for="aktifCheck">Aktif</label>
        </div>

        @if (!duzenlenenKisi.Aktif)
        {
            <div class="mb-3">
                <label class="form-label">Yasaklanma Sebebi</label>
                <input class="form-control" @bind:get="duzenlenenKisi.YasaklanmaSebebi" @bind:set="v => duzenlenenKisi.YasaklanmaSebebi = MetinYardimci.BuyukHarf(v)" @bind:event="oninput" />
            </div>
        }

        <fieldset class="mb-3">
            <legend class="form-label fs-6">Ziyaretçi Niteliği</legend>
            <div class="form-check form-check-inline">
                <InputCheckbox class="form-check-input" @bind-Value="duzenlenenKisi.TekneSahibi" id="tekneSahibiCheck" />
                <label class="form-check-label" for="tekneSahibiCheck">Tekne Sahibi</label>
            </div>
            <div class="form-check form-check-inline">
                <InputCheckbox class="form-check-input" @bind-Value="duzenlenenKisi.Kaptan" id="kaptanCheck" />
                <label class="form-check-label" for="kaptanCheck">Kaptan</label>
            </div>
            <div class="form-check form-check-inline">
                <InputCheckbox class="form-check-input" @bind-Value="duzenlenenKisi.TeknePersoneli" id="teknePersoneliCheck" />
                <label class="form-check-label" for="teknePersoneliCheck">Tekne Personeli</label>
            </div>
        </fieldset>

        @if (belgeDurumSatirlari is not null)
        {
            <div class="table-responsive mb-3">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Belge</th>
                        <th>Alındı</th>
                        <th>Detay</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>KVKK Onay Formu</td>
                        <td>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="kvkkAlindiCheck" @bind="duzenlenenKisi.KvkkOnayFormuAlindi" />
                                <label class="form-check-label" for="kvkkAlindiCheck">Alındı</label>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <input type="date" class="form-control" style="width: auto;" disabled="@(!duzenlenenKisi.KvkkOnayFormuAlindi)" @bind="duzenlenenKisi.KvkkOnayTarihi" />
                                <select class="form-select" style="width: auto;" @bind="duzenlenenKisi.KvkkOnayDurumu">
                                    <option value="@KvkkOnayDurumu.Bilinmiyor">Bilinmiyor</option>
                                    <option value="@KvkkOnayDurumu.OnayVerildi">Onay Verildi</option>
                                    <option value="@KvkkOnayDurumu.OnayVerilmedi">Onay Verilmedi</option>
                                </select>
                            </div>
                        </td>
                    </tr>
                    @foreach (var satir in belgeDurumSatirlari)
                    {
                        <tr>
                            <td>@satir.Belge.BelgeTanimi</td>
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="belge-alindi-@satir.Belge.Id" @bind="satir.Alindi" />
                                    <label class="form-check-label" for="belge-alindi-@satir.Belge.Id">Alındı</label>
                                </div>
                            </td>
                            <td>
                                @if (satir.Belge.GecerlilikTarihiKontrolu)
                                {
                                    <input type="date" class="form-control" style="width: auto; display: inline-block;" disabled="@(!satir.Alindi)" @bind="satir.GecerlilikTarihi" />
                                    @if (satir.GecerlilikTarihi is not null && satir.GecerlilikTarihi.Value.Date < DateTime.Today)
                                    {
                                        <span class="badge bg-danger ms-2">Süresi geçmiş</span>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
            </div>
        </div>
    </EditForm>
}

@if (!formAcik)
{
    <div class="mb-3">
        <input type="search" class="form-control" style="max-width: 400px;"
               placeholder="Aramak için yazın (kimlik no, ad soyad, firma, telefon)..."
               @bind:get="aramaMetni" @bind:set="AramaDegisti" @bind:event="oninput" autocomplete="off" />
    </div>

    @if (aramaSonuclari is null)
    {
        <p>Aramak için yukarıya yazın.</p>
    }
    else if (aramaSonuclari.Count == 0)
    {
        <p>Aramanızla eşleşen kayıt bulunamadı.</p>
    }
    else
    {
    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th role="button" class="text-nowrap" @onclick='() => SiralamayiDegistir("KimlikNumarasi")'>Kimlik No @SiralamaIsareti("KimlikNumarasi")</th>
                <th role="button" class="text-nowrap" @onclick='() => SiralamayiDegistir("AdSoyad")'>Ad Soyad @SiralamaIsareti("AdSoyad")</th>
                <th role="button" class="text-nowrap" @onclick='() => SiralamayiDegistir("FirmaAdi")'>Firma @SiralamaIsareti("FirmaAdi")</th>
                <th role="button" class="text-nowrap" @onclick='() => SiralamayiDegistir("Telefon")'>Telefon @SiralamaIsareti("Telefon")</th>
                <th>Nitelik</th>
                <th role="button" class="text-nowrap" @onclick='() => SiralamayiDegistir("Durum")'>Durum @SiralamaIsareti("Durum")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kisi in aramaSonuclari)
            {
                <tr>
                    <td>@kisi.KimlikNumarasi</td>
                    <td>@kisi.AdSoyad</td>
                    <td>@kisi.FirmaAdi</td>
                    <td>@kisi.Telefon</td>
                    <td>
                        @if (kisi.TekneSahibi)
                        {
                            <span class="badge bg-info text-dark me-1">Tekne Sahibi</span>
                        }
                        @if (kisi.Kaptan)
                        {
                            <span class="badge bg-info text-dark me-1">Kaptan</span>
                        }
                        @if (kisi.TeknePersoneli)
                        {
                            <span class="badge bg-info text-dark me-1">Tekne Personeli</span>
                        }
                    </td>
                    <td>
                        @if (kisi.Aktif)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                        @if (!string.IsNullOrEmpty(kisi.YasaklanmaSebebi))
                        {
                            <span class="badge bg-danger ms-1" title="@kisi.YasaklanmaSebebi">Yasaklı</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-outline-primary" @onclick="() => DuzenlemeBaslat(kisi)">Düzenle</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (aramaSonuclari.Count == AramaSonucLimiti)
    {
        <p class="text-muted">İlk @AramaSonucLimiti sonuç gösteriliyor — daha spesifik arayın.</p>
    }
    }
}

</div>

@code {
    // 21.000+ kişi kaydına ulaşıldıktan sonra (2026-08-25 veri aktarımı)
    // tüm listeyi belleğe çekip içinde arama yapmak ~750ms sürüyordu — bkz.
    // CLAUDE.md > Performans notu. Artık liste hiç önceden yüklenmiyor,
    // kullanıcı yazana kadar placeholder gösteriliyor; yazınca sunucuda
    // debounce'lu bir DB sorgusu (Take ile sınırlı) çalışıyor.
    private const int AramaSonucLimiti = 50;

    private List<string> firmaOnerileri = [];
    private Kisi duzenlenenKisi = new();
    private bool formAcik;
    private string? hataMesaji;
    private string? basariMesaji;
    private bool basariUyariMi;

    private string aramaMetni = string.Empty;
    private List<Kisi>? aramaSonuclari;
    private CancellationTokenSource? aramaCts;
    private string siralamaAlani = "AdSoyad";
    private bool siralamaArtan = true;

    private List<Kisi> eslesenKisilerForm = [];
    private CancellationTokenSource? kimlikAramaCts;

    private IQueryable<Kisi> AramaSorgusu(ApplicationDbContext db, string arama)
    {
        var sorgu = db.Kisiler.AsNoTracking().Where(k =>
            k.KimlikNumarasi.Contains(arama) ||
            k.AdSoyad.Contains(arama) ||
            (k.FirmaAdi != null && k.FirmaAdi.Contains(arama)) ||
            (k.Telefon != null && k.Telefon.Contains(arama)));

        return siralamaAlani switch
        {
            "KimlikNumarasi" => siralamaArtan ? sorgu.OrderBy(k => k.KimlikNumarasi) : sorgu.OrderByDescending(k => k.KimlikNumarasi),
            "FirmaAdi" => siralamaArtan ? sorgu.OrderBy(k => k.FirmaAdi) : sorgu.OrderByDescending(k => k.FirmaAdi),
            "Telefon" => siralamaArtan ? sorgu.OrderBy(k => k.Telefon) : sorgu.OrderByDescending(k => k.Telefon),
            "Durum" => siralamaArtan ? sorgu.OrderBy(k => k.Aktif) : sorgu.OrderByDescending(k => k.Aktif),
            _ => siralamaArtan ? sorgu.OrderBy(k => k.AdSoyad) : sorgu.OrderByDescending(k => k.AdSoyad),
        };
    }

    private async Task AramaDegisti(string? v)
    {
        aramaMetni = v ?? string.Empty;

        aramaCts?.Cancel();
        var cts = new CancellationTokenSource();
        aramaCts = cts;

        var arama = aramaMetni.Trim();
        if (string.IsNullOrEmpty(arama))
        {
            aramaSonuclari = null;
            return;
        }

        try
        {
            await Task.Delay(250, cts.Token);
            await using var db = await DbFactory.CreateDbContextAsync(cts.Token);
            aramaSonuclari = await AramaSorgusu(db, arama).Take(AramaSonucLimiti).ToListAsync(cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Kullanıcı yazmaya devam etti, bu arama artık geçersiz.
        }
    }

    private async Task AramaSonuclariniYenile()
    {
        var arama = aramaMetni.Trim();
        if (string.IsNullOrEmpty(arama))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        aramaSonuclari = await AramaSorgusu(db, arama).Take(AramaSonucLimiti).ToListAsync();
    }

    private async Task SiralamayiDegistir(string alan)
    {
        if (siralamaAlani == alan)
        {
            siralamaArtan = !siralamaArtan;
        }
        else
        {
            siralamaAlani = alan;
            siralamaArtan = true;
        }

        await AramaSonuclariniYenile();
    }

    private string SiralamaIsareti(string alan) => siralamaAlani != alan ? "" : (siralamaArtan ? "▲" : "▼");

    private async Task KimlikNumarasiInputDegisti(string? v)
    {
        duzenlenenKisi.KimlikNumarasi = MetinYardimci.BuyukHarf(v)!;

        kimlikAramaCts?.Cancel();

        if (duzenlenenKisi.Id != 0)
        {
            eslesenKisilerForm = [];
            return;
        }

        var cts = new CancellationTokenSource();
        kimlikAramaCts = cts;

        var arama = duzenlenenKisi.KimlikNumarasi.Trim();
        if (string.IsNullOrEmpty(arama))
        {
            eslesenKisilerForm = [];
            return;
        }

        try
        {
            await Task.Delay(200, cts.Token);
            await using var db = await DbFactory.CreateDbContextAsync(cts.Token);
            eslesenKisilerForm = await db.Kisiler.AsNoTracking()
                .Where(k => k.KimlikNumarasi.Contains(arama))
                .OrderBy(k => k.KimlikNumarasi)
                .Take(5)
                .ToListAsync(cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Kullanıcı yazmaya devam etti, bu arama artık geçersiz.
        }
    }

    private List<BelgeDurumSatiri>? belgeDurumSatirlari;

    private sealed class BelgeDurumSatiri
    {
        public KisiBelge Belge { get; set; } = null!;
        public bool Alindi { get; set; }
        public DateTime? GecerlilikTarihi { get; set; }
    }

    [SupplyParameterFromQuery(Name = "duzenle")]
    public int? SorguDuzenleId { get; set; }

    [SupplyParameterFromQuery(Name = "yeniKimlik")]
    public string? SorguYeniKimlik { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await FirmaOnerileriYukle();

        if (SorguDuzenleId is int id)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var kisi = await db.Kisiler.AsNoTracking().FirstOrDefaultAsync(k => k.Id == id);
            if (kisi is not null)
            {
                await DuzenlemeBaslat(kisi);
            }
        }
        else if (!string.IsNullOrWhiteSpace(SorguYeniKimlik))
        {
            await YeniKisiBaslat();
            duzenlenenKisi.KimlikNumarasi = SorguYeniKimlik;
        }
    }

    private async Task<string?> AktifKullaniciAdi()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        return authState.User?.Identity?.Name;
    }

    private async Task FirmaOnerileriYukle()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        firmaOnerileri = await db.Kisiler
            .Where(k => k.FirmaAdi != null && k.FirmaAdi != "")
            .Select(k => k.FirmaAdi!)
            .Distinct()
            .OrderBy(f => f)
            .ToListAsync();
    }

    private async Task YeniKisiBaslat()
    {
        duzenlenenKisi = new Kisi { Aktif = true };
        eslesenKisilerForm = [];
        kimlikAramaCts?.Cancel();
        hataMesaji = null;
        basariMesaji = null;
        formAcik = true;
        await BelgeDurumlariniYukle(null);
    }

    private async Task DuzenlemeBaslat(Kisi kisi)
    {
        eslesenKisilerForm = [];
        kimlikAramaCts?.Cancel();
        duzenlenenKisi = new Kisi
        {
            Id = kisi.Id,
            KimlikNumarasi = kisi.KimlikNumarasi,
            AdSoyad = kisi.AdSoyad,
            FirmaAdi = kisi.FirmaAdi,
            Telefon = kisi.Telefon,
            Aktif = kisi.Aktif,
            YasaklanmaSebebi = kisi.YasaklanmaSebebi,
            TekneSahibi = kisi.TekneSahibi,
            Kaptan = kisi.Kaptan,
            TeknePersoneli = kisi.TeknePersoneli,
            KvkkOnayFormuAlindi = kisi.KvkkOnayFormuAlindi,
            KvkkOnayDurumu = kisi.KvkkOnayDurumu,
            KvkkOnayTarihi = kisi.KvkkOnayTarihi
        };
        hataMesaji = null;
        basariMesaji = null;
        formAcik = true;
        await BelgeDurumlariniYukle(kisi.Id);
    }

    private void FormuKapat()
    {
        formAcik = false;
        hataMesaji = null;
        belgeDurumSatirlari = null;
    }

    private async Task BelgeDurumlariniYukle(int? kisiId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var kurallar = await db.KisiBelgeleri
            .Where(b => b.Aktif)
            .OrderBy(b => b.BelgeTanimi)
            .ToListAsync();

        var mevcutDurumlar = kisiId is int id
            ? await db.KisiBelgeKontrolleri.Where(k => k.KisiId == id).ToListAsync()
            : [];

        belgeDurumSatirlari = kurallar.Select(kural =>
        {
            var mevcut = mevcutDurumlar.FirstOrDefault(d => d.KisiBelgeId == kural.Id);
            return new BelgeDurumSatiri
            {
                Belge = kural,
                Alindi = mevcut?.AlindiSonucu ?? false,
                GecerlilikTarihi = mevcut?.GecerlilikTarihiSonucu
            };
        }).ToList();
    }

    private async Task Kaydet()
    {
        hataMesaji = null;
        basariMesaji = null;

        // Yasaklanma Sebebi yalnızca Pasif kişilerde tutulur (bkz. CK_Kisiler_YasaklanmaSebebi_Aktif).
        if (duzenlenenKisi.Aktif)
        {
            duzenlenenKisi.YasaklanmaSebebi = null;
        }

        // Alındı işaretli değilse tarih anlamsızdır, temizlenir ve kullanıcı uyarılır.
        var uyariBelgeleri = new List<string>();
        if (!duzenlenenKisi.KvkkOnayFormuAlindi && duzenlenenKisi.KvkkOnayTarihi is not null)
        {
            uyariBelgeleri.Add("KVKK Onay Formu");
            duzenlenenKisi.KvkkOnayTarihi = null;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            Kisi kisi;
            var yeniKayit = duzenlenenKisi.Id == 0;

            if (yeniKayit)
            {
                kisi = duzenlenenKisi;
                db.Kisiler.Add(kisi);
            }
            else
            {
                var mevcut = await db.Kisiler.FindAsync(duzenlenenKisi.Id);
                if (mevcut is null)
                {
                    hataMesaji = "Kayıt bulunamadı, sayfayı yenileyin.";
                    return;
                }

                mevcut.KimlikNumarasi = duzenlenenKisi.KimlikNumarasi;
                mevcut.AdSoyad = duzenlenenKisi.AdSoyad;
                mevcut.FirmaAdi = duzenlenenKisi.FirmaAdi;
                mevcut.Telefon = duzenlenenKisi.Telefon;
                mevcut.Aktif = duzenlenenKisi.Aktif;
                mevcut.YasaklanmaSebebi = duzenlenenKisi.YasaklanmaSebebi;
                mevcut.TekneSahibi = duzenlenenKisi.TekneSahibi;
                mevcut.Kaptan = duzenlenenKisi.Kaptan;
                mevcut.TeknePersoneli = duzenlenenKisi.TeknePersoneli;
                mevcut.KvkkOnayFormuAlindi = duzenlenenKisi.KvkkOnayFormuAlindi;
                mevcut.KvkkOnayDurumu = duzenlenenKisi.KvkkOnayDurumu;
                mevcut.KvkkOnayTarihi = duzenlenenKisi.KvkkOnayTarihi;
                kisi = mevcut;
            }

            if (belgeDurumSatirlari is not null)
            {
                foreach (var satir in belgeDurumSatirlari)
                {
                    if (!satir.Alindi && satir.GecerlilikTarihi is not null)
                    {
                        uyariBelgeleri.Add(satir.Belge.BelgeTanimi);
                        satir.GecerlilikTarihi = null;
                    }

                    var gecerlilikTarihi = satir.Belge.GecerlilikTarihiKontrolu ? satir.GecerlilikTarihi : null;

                    var mevcutKontrol = yeniKayit
                        ? null
                        : await db.KisiBelgeKontrolleri
                            .FirstOrDefaultAsync(k => k.KisiId == kisi.Id && k.KisiBelgeId == satir.Belge.Id);

                    if (mevcutKontrol is null)
                    {
                        var yeniKontrol = new KisiBelgeKontrol
                        {
                            KisiBelgeId = satir.Belge.Id,
                            AlindiSonucu = satir.Alindi,
                            GecerlilikTarihiSonucu = gecerlilikTarihi
                        };

                        // Yeni kişi için Id henüz atanmadı (SaveChanges'ten sonra
                        // atanır) — navigation ile ilişki kurulur, EF Core FK'yı
                        // otomatik doldurur.
                        if (yeniKayit)
                        {
                            yeniKontrol.Kisi = kisi;
                        }
                        else
                        {
                            yeniKontrol.KisiId = kisi.Id;
                        }

                        db.KisiBelgeKontrolleri.Add(yeniKontrol);
                    }
                    else
                    {
                        mevcutKontrol.AlindiSonucu = satir.Alindi;
                        mevcutKontrol.GecerlilikTarihiSonucu = gecerlilikTarihi;
                    }
                }
            }

            db.MevcutKullanici = await AktifKullaniciAdi();
            await db.SaveChangesAsync();
            await FirmaOnerileriYukle();
            await AramaSonuclariniYenile();

            basariUyariMi = uyariBelgeleri.Count > 0;
            var mesaj = basariUyariMi
                ? $"Kaydedildi. Alındı işaretli olmadığı için şu belgelerin tarihi boş kaydedildi: {string.Join(", ", uyariBelgeleri)}."
                : "Kaydedildi.";

            if (yeniKayit)
            {
                // Yeni kayıt butonuna basılmış gibi ekran temizlenir — art
                // arda hızlı veri girişine izin vermek için.
                duzenlenenKisi = new Kisi { Aktif = true };
                eslesenKisilerForm = [];
                kimlikAramaCts?.Cancel();
                await BelgeDurumlariniYukle(null);
            }
            else
            {
                // Düzenleme modunda aynı kayıt üzerinde kalınır.
                await DuzenlemeBaslat(kisi);
            }
            basariMesaji = mesaj;
        }
        catch (DbUpdateException)
        {
            hataMesaji = "Bu kimlik numarası zaten kayıtlı.";
        }
    }
}
