@page "/kisiler"
@attribute [Authorize(Roles = $"{Roller.Yonetici},{Roller.SahaKontroloru}")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ViaCekek.Web.Data
@using ViaCekek.Web.Models
@inject ApplicationDbContext Db

<PageTitle>Kişi Tanımları</PageTitle>

<h3>Kişi Tanımları</h3>

@if (hataMesaji is not null)
{
    <div class="alert alert-danger">@hataMesaji</div>
}

<button class="btn btn-lg btn-primary mb-3" @onclick="YeniKisiBaslat">+ Yeni Kişi</button>

@if (formAcik)
{
    <EditForm Model="duzenlenenKisi" OnValidSubmit="Kaydet" class="card card-body mb-3">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row">
            <div class="col-md-4 mb-2">
                <label class="form-label">Kimlik Numarası</label>
                <InputText class="form-control" @bind-Value="duzenlenenKisi.KimlikNumarasi" />
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">Ad Soyad</label>
                <InputText class="form-control" @bind-Value="duzenlenenKisi.AdSoyad" />
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">Telefon</label>
                <InputText class="form-control" @bind-Value="duzenlenenKisi.Telefon" placeholder="5XXXXXXXXX" />
            </div>
        </div>

        <div class="mb-2">
            <label class="form-label">Firma Adı</label>
            <input class="form-control" list="firmaListesi" @bind="duzenlenenKisi.FirmaAdi" />
            <datalist id="firmaListesi">
                @foreach (var firma in firmaOnerileri)
                {
                    <option value="@firma" />
                }
            </datalist>
        </div>

        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="duzenlenenKisi.Aktif" id="aktifCheck" />
            <label class="form-check-label" for="aktifCheck">Aktif</label>
        </div>

        @if (!duzenlenenKisi.Aktif)
        {
            <div class="mb-3">
                <label class="form-label">Yasaklanma Sebebi</label>
                <InputText class="form-control" @bind-Value="duzenlenenKisi.YasaklanmaSebebi" />
            </div>
        }

        <fieldset class="mb-3">
            <legend class="form-label fs-6">Ziyaretçi Niteliği</legend>
            <div class="form-check form-check-inline">
                <InputCheckbox class="form-check-input" @bind-Value="duzenlenenKisi.TekneSahibi" id="tekneSahibiCheck" />
                <label class="form-check-label" for="tekneSahibiCheck">Tekne Sahibi</label>
            </div>
            <div class="form-check form-check-inline">
                <InputCheckbox class="form-check-input" @bind-Value="duzenlenenKisi.Kaptan" id="kaptanCheck" />
                <label class="form-check-label" for="kaptanCheck">Kaptan</label>
            </div>
            <div class="form-check form-check-inline">
                <InputCheckbox class="form-check-input" @bind-Value="duzenlenenKisi.TeknePersoneli" id="teknePersoneliCheck" />
                <label class="form-check-label" for="teknePersoneliCheck">Tekne Personeli</label>
            </div>
        </fieldset>

        <div>
            <button type="submit" class="btn btn-lg btn-success">Kaydet</button>
            <button type="button" class="btn btn-lg btn-secondary" @onclick="FormuKapat">@(duzenlenenKisi.Id == 0 ? "İptal" : "Kapat")</button>
        </div>
    </EditForm>
}

@if (formAcik && belgeDurumSatirlari is not null)
{
    <div class="card card-body mb-3">
        <h5>Belgeler</h5>
        <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Belge</th>
                    <th>Alındı</th>
                    <th>Detay</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>KVKK Onay Formu</td>
                    <td>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="kvkkAlindiCheck" @bind="duzenlenenKisi.KvkkOnayFormuAlindi" />
                            <label class="form-check-label" for="kvkkAlindiCheck">Alındı</label>
                        </div>
                    </td>
                    <td>
                        <div class="d-flex gap-2 flex-wrap">
                            <select class="form-select" style="width: auto;" @bind="duzenlenenKisi.KvkkOnayDurumu">
                                <option value="@KvkkOnayDurumu.Bilinmiyor">Bilinmiyor</option>
                                <option value="@KvkkOnayDurumu.OnayVerildi">Onay Verildi</option>
                                <option value="@KvkkOnayDurumu.OnayVerilmedi">Onay Verilmedi</option>
                            </select>
                            <input type="date" class="form-control" style="width: auto;" @bind="duzenlenenKisi.KvkkOnayTarihi" />
                        </div>
                    </td>
                </tr>
                @foreach (var satir in belgeDurumSatirlari)
                {
                    <tr>
                        <td>@satir.Belge.BelgeTanimi</td>
                        <td>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="belge-alindi-@satir.Belge.Id" @bind="satir.Alindi" />
                                <label class="form-check-label" for="belge-alindi-@satir.Belge.Id">Alındı</label>
                            </div>
                        </td>
                        <td>
                            @if (satir.Belge.GecerlilikTarihiKontrolu)
                            {
                                <input type="date" class="form-control" style="width: auto; display: inline-block;" @bind="satir.GecerlilikTarihi" />
                                @if (satir.GecerlilikTarihi is not null && satir.GecerlilikTarihi.Value.Date < DateTime.Today)
                                {
                                    <span class="badge bg-danger ms-2">Süresi geçmiş</span>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <button class="btn btn-lg btn-success mt-2" @onclick="BelgeleriKaydet">Belgeleri Kaydet</button>
        @if (belgeHataMesaji is not null)
        {
            <div class="alert alert-danger mt-2">@belgeHataMesaji</div>
        }
        @if (belgeBasariMesaji is not null)
        {
            <div class="alert alert-success mt-2">@belgeBasariMesaji</div>
        }
    </div>
}

@if (!formAcik)
{
@if (kisiler is null)
{
    <p>Yükleniyor...</p>
}
else if (kisiler.Count == 0)
{
    <p>Henüz kişi kaydı yok.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Kimlik No</th>
                <th>Ad Soyad</th>
                <th>Firma</th>
                <th>Telefon</th>
                <th>Nitelik</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kisi in kisiler)
            {
                <tr>
                    <td>@kisi.KimlikNumarasi</td>
                    <td>@kisi.AdSoyad</td>
                    <td>@kisi.FirmaAdi</td>
                    <td>@kisi.Telefon</td>
                    <td>
                        @if (kisi.TekneSahibi)
                        {
                            <span class="badge bg-info text-dark me-1">Tekne Sahibi</span>
                        }
                        @if (kisi.Kaptan)
                        {
                            <span class="badge bg-info text-dark me-1">Kaptan</span>
                        }
                        @if (kisi.TeknePersoneli)
                        {
                            <span class="badge bg-info text-dark me-1">Tekne Personeli</span>
                        }
                    </td>
                    <td>
                        @if (kisi.Aktif)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                        @if (!string.IsNullOrEmpty(kisi.YasaklanmaSebebi))
                        {
                            <span class="badge bg-danger ms-1" title="@kisi.YasaklanmaSebebi">Yasaklı</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-outline-primary" @onclick="() => DuzenlemeBaslat(kisi)">Düzenle</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
}

@code {
    private List<Kisi>? kisiler;
    private List<string> firmaOnerileri = [];
    private Kisi duzenlenenKisi = new();
    private bool formAcik;
    private string? hataMesaji;

    private List<BelgeDurumSatiri>? belgeDurumSatirlari;
    private string? belgeHataMesaji;
    private string? belgeBasariMesaji;

    private sealed class BelgeDurumSatiri
    {
        public KisiBelge Belge { get; set; } = null!;
        public bool Alindi { get; set; }
        public DateTime? GecerlilikTarihi { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await ListeyiYenile();
    }

    private async Task ListeyiYenile()
    {
        kisiler = await Db.Kisiler.OrderBy(k => k.AdSoyad).ToListAsync();
        firmaOnerileri = await Db.Kisiler
            .Where(k => k.FirmaAdi != null && k.FirmaAdi != "")
            .Select(k => k.FirmaAdi!)
            .Distinct()
            .OrderBy(f => f)
            .ToListAsync();
    }

    private void YeniKisiBaslat()
    {
        duzenlenenKisi = new Kisi { Aktif = true };
        hataMesaji = null;
        belgeDurumSatirlari = null;
        belgeHataMesaji = null;
        belgeBasariMesaji = null;
        formAcik = true;
    }

    private async Task DuzenlemeBaslat(Kisi kisi)
    {
        duzenlenenKisi = new Kisi
        {
            Id = kisi.Id,
            KimlikNumarasi = kisi.KimlikNumarasi,
            AdSoyad = kisi.AdSoyad,
            FirmaAdi = kisi.FirmaAdi,
            Telefon = kisi.Telefon,
            Aktif = kisi.Aktif,
            YasaklanmaSebebi = kisi.YasaklanmaSebebi,
            TekneSahibi = kisi.TekneSahibi,
            Kaptan = kisi.Kaptan,
            TeknePersoneli = kisi.TeknePersoneli,
            KvkkOnayFormuAlindi = kisi.KvkkOnayFormuAlindi,
            KvkkOnayDurumu = kisi.KvkkOnayDurumu,
            KvkkOnayTarihi = kisi.KvkkOnayTarihi
        };
        hataMesaji = null;
        belgeHataMesaji = null;
        belgeBasariMesaji = null;
        formAcik = true;
        await BelgeDurumlariniYukle(kisi.Id);
    }

    private void FormuKapat()
    {
        formAcik = false;
        hataMesaji = null;
        belgeDurumSatirlari = null;
    }

    private async Task BelgeDurumlariniYukle(int kisiId)
    {
        var kurallar = await Db.KisiBelgeleri
            .Where(b => b.Aktif)
            .OrderBy(b => b.BelgeTanimi)
            .ToListAsync();

        var mevcutDurumlar = await Db.KisiBelgeKontrolleri
            .Where(k => k.KisiId == kisiId)
            .ToListAsync();

        belgeDurumSatirlari = kurallar.Select(kural =>
        {
            var mevcut = mevcutDurumlar.FirstOrDefault(d => d.KisiBelgeId == kural.Id);
            return new BelgeDurumSatiri
            {
                Belge = kural,
                Alindi = mevcut?.AlindiSonucu ?? false,
                GecerlilikTarihi = mevcut?.GecerlilikTarihiSonucu
            };
        }).ToList();
    }

    private async Task BelgeleriKaydet()
    {
        if (belgeDurumSatirlari is null)
        {
            return;
        }

        belgeHataMesaji = null;
        belgeBasariMesaji = null;

        try
        {
            var kisi = await Db.Kisiler.FindAsync(duzenlenenKisi.Id);
            if (kisi is null)
            {
                belgeHataMesaji = "Kişi bulunamadı, sayfayı yenileyin.";
                return;
            }

            kisi.KvkkOnayFormuAlindi = duzenlenenKisi.KvkkOnayFormuAlindi;
            kisi.KvkkOnayDurumu = duzenlenenKisi.KvkkOnayDurumu;
            kisi.KvkkOnayTarihi = duzenlenenKisi.KvkkOnayTarihi;

            foreach (var satir in belgeDurumSatirlari)
            {
                var mevcut = await Db.KisiBelgeKontrolleri
                    .FirstOrDefaultAsync(k => k.KisiId == duzenlenenKisi.Id && k.KisiBelgeId == satir.Belge.Id);

                var gecerlilikTarihi = satir.Belge.GecerlilikTarihiKontrolu ? satir.GecerlilikTarihi : null;

                if (mevcut is null)
                {
                    Db.KisiBelgeKontrolleri.Add(new KisiBelgeKontrol
                    {
                        KisiId = duzenlenenKisi.Id,
                        KisiBelgeId = satir.Belge.Id,
                        AlindiSonucu = satir.Alindi,
                        GecerlilikTarihiSonucu = gecerlilikTarihi
                    });
                }
                else
                {
                    mevcut.AlindiSonucu = satir.Alindi;
                    mevcut.GecerlilikTarihiSonucu = gecerlilikTarihi;
                }
            }

            await Db.SaveChangesAsync();
            belgeBasariMesaji = "Belge durumları kaydedildi.";
        }
        catch (DbUpdateException)
        {
            belgeHataMesaji = "Belgeler kaydedilirken bir hata oluştu.";
        }
    }

    private async Task Kaydet()
    {
        hataMesaji = null;

        // Yasaklanma Sebebi yalnızca Pasif kişilerde tutulur (bkz. CK_Kisiler_YasaklanmaSebebi_Aktif).
        if (duzenlenenKisi.Aktif)
        {
            duzenlenenKisi.YasaklanmaSebebi = null;
        }

        try
        {
            if (duzenlenenKisi.Id == 0)
            {
                Db.Kisiler.Add(duzenlenenKisi);
            }
            else
            {
                var mevcut = await Db.Kisiler.FindAsync(duzenlenenKisi.Id);
                if (mevcut is null)
                {
                    hataMesaji = "Kayıt bulunamadı, sayfayı yenileyin.";
                    return;
                }

                mevcut.KimlikNumarasi = duzenlenenKisi.KimlikNumarasi;
                mevcut.AdSoyad = duzenlenenKisi.AdSoyad;
                mevcut.FirmaAdi = duzenlenenKisi.FirmaAdi;
                mevcut.Telefon = duzenlenenKisi.Telefon;
                mevcut.Aktif = duzenlenenKisi.Aktif;
                mevcut.YasaklanmaSebebi = duzenlenenKisi.YasaklanmaSebebi;
                mevcut.TekneSahibi = duzenlenenKisi.TekneSahibi;
                mevcut.Kaptan = duzenlenenKisi.Kaptan;
                mevcut.TeknePersoneli = duzenlenenKisi.TeknePersoneli;
                mevcut.KvkkOnayFormuAlindi = duzenlenenKisi.KvkkOnayFormuAlindi;
                mevcut.KvkkOnayDurumu = duzenlenenKisi.KvkkOnayDurumu;
                mevcut.KvkkOnayTarihi = duzenlenenKisi.KvkkOnayTarihi;
            }

            await Db.SaveChangesAsync();
            await ListeyiYenile();
            await BelgeDurumlariniYukle(duzenlenenKisi.Id);
        }
        catch (DbUpdateException)
        {
            hataMesaji = "Bu kimlik numarası zaten kayıtlı.";
        }
    }
}
