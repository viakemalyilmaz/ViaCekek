@page "/cekektakip"
@attribute [Authorize(Roles = $"{Roller.Yonetici},{Roller.SahaKontroloru},{Roller.Guvenlik}")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ViaCekek.Web.Data
@using ViaCekek.Web.Models
@using ViaCekek.Web.Models.Common
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Çekek Takip</PageTitle>

<h3>Çekek Takip</h3>

@if (basariMesaji is not null)
{
    <div class="alert alert-success">@basariMesaji</div>
}

@if (asama == Asama.Sorgu)
{
    <form @onsubmit="KontrolYap" class="card card-body mb-3">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Kimlik Numarası (Kişi)</label>
                <div class="input-group">
                    <input class="form-control form-control-lg"
                           @bind:get="kimlikNumarasi" @bind:set="KimlikNumarasiDegisti" @bind:event="oninput"
                           autocomplete="off" autofocus />
                    <button type="button" class="btn btn-outline-secondary btn-lg" @onclick="KameraAc" title="Kamerayla Okut">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                            <circle cx="12" cy="13" r="4" />
                        </svg>
                    </button>
                </div>
                @if (eslesenKisiler.Count > 0)
                {
                    <div class="list-group mt-1">
                        @foreach (var eslesen in eslesenKisiler)
                        {
                            <button type="button" class="list-group-item list-group-item-action py-1" @onclick="() => EslesenKisiSec(eslesen)">
                                <strong>@eslesen.KimlikNumarasi</strong> — @eslesen.AdSoyad
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Takip Numarası (Araç)</label>
                <input class="form-control form-control-lg"
                       @bind:get="takipNumarasi" @bind:set="TakipNumarasiDegisti" @bind:event="oninput"
                       autocomplete="off" />
                @if (eslesenAraclar.Count > 0)
                {
                    <div class="list-group mt-1">
                        @foreach (var eslesen in eslesenAraclar)
                        {
                            <button type="button" class="list-group-item list-group-item-action py-1" @onclick="() => EslesenAracSec(eslesen)">
                                <strong>@eslesen.TakipNumarasi</strong> — @AracTuruAdi(eslesen.AracTuru)
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Ziyaret Sebebi</label>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var sebep in ziyaretSebepleri)
                {
                    <input type="radio" class="btn-check" name="ziyaretSebebi" id="zs-@sebep" autocomplete="off"
                           checked="@(ziyaretSebebi == sebep)" @onchange="() => ziyaretSebebi = sebep" />
                    <label class="btn btn-outline-success" for="zs-@sebep">@ZiyaretSebebiAdi(sebep)</label>
                }
            </div>
        </div>

        <div>
            <button type="submit" class="btn btn-lg btn-primary">Kontrol</button>
        </div>

        @if (kisiEngelMesaji is not null)
        {
            <div class="alert alert-danger mt-3">
                <strong>Kişi:</strong> @kisiEngelMesaji
                @if (kisiEngelYonlendirmeGoster)
                {
                    <div class="mt-2">
                        @if (bulunanKisiId is int engelKisiId)
                        {
                            <a class="btn btn-outline-primary" href="@($"kisiler?duzenle={engelKisiId}")">Kişi Tanımları'na git</a>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary" href="@($"kisiler?yeniKimlik={Uri.EscapeDataString(kimlikNumarasi.Trim())}")">+ Yeni Kişi ekle</a>
                        }
                    </div>
                }
            </div>
        }

        @if (kisiEksikBelgeler.Count > 0)
        {
            <div class="alert alert-danger mt-3">
                <div><strong>Kişi</strong> — Eksik/süresi geçmiş belge(ler):</div>
                <ul class="mb-2">
                    @foreach (var belge in kisiEksikBelgeler)
                    {
                        <li>@belge</li>
                    }
                </ul>
                <a class="btn btn-outline-primary" href="@($"kisiler?duzenle={bulunanKisiId}")">Kişi Tanımları'na git</a>
            </div>
        }

        @if (aracEngelMesaji is not null)
        {
            <div class="alert alert-danger mt-3">
                <strong>Araç:</strong> @aracEngelMesaji
                @if (aracEngelYonlendirmeGoster)
                {
                    <div class="mt-2">
                        @if (bulunanAracId is int engelAracId)
                        {
                            <a class="btn btn-outline-primary" href="@($"araclar?duzenle={engelAracId}")">Araç Tanımları'na git</a>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary" href="@($"araclar?yeniTakip={Uri.EscapeDataString(takipNumarasi.Trim())}")">+ Yeni Araç ekle</a>
                        }
                    </div>
                }
            </div>
        }

        @if (aracEksikBelgeler.Count > 0)
        {
            <div class="alert alert-danger mt-3">
                <div><strong>Araç</strong> — Eksik/süresi geçmiş belge(ler):</div>
                <ul class="mb-2">
                    @foreach (var belge in aracEksikBelgeler)
                    {
                        <li>@belge</li>
                    }
                </ul>
                <a class="btn btn-outline-primary" href="@($"araclar?duzenle={bulunanAracId}")">Araç Tanımları'na git</a>
            </div>
        }
    </form>
}
else if (asama == Asama.Onay)
{
    <div class="card card-body mb-3">
        @if (yaklasanBelgeler.Count > 0)
        {
            <div class="hatirlatma-kutusu mb-3">
                <div>Bitiş tarihi yaklaşan belge(ler):</div>
                <ul class="mb-0">
                    @foreach (var belge in yaklasanBelgeler)
                    {
                        <li>@belge</li>
                    }
                </ul>
            </div>
        }

        <div class="mb-3">
            @if (bulunanKisi is not null)
            {
                <div><strong>Kişi:</strong> @bulunanKisi.KimlikNumarasi — @bulunanKisi.AdSoyad</div>
            }
            @if (bulunanArac is not null)
            {
                <div><strong>Araç:</strong> @bulunanArac.TakipNumarasi — @AracTuruAdi(bulunanArac.AracTuru)</div>
            }
        </div>

        @if (bulunanKisi is null && !string.IsNullOrWhiteSpace(kimlikNumarasi))
        {
            <div class="alert alert-warning">
                <div>Kişi girişi yapılmayacak — sadece araç girişi kaydedilecek.</div>
                @if (kisiEngelMesaji is not null)
                {
                    <div>@kisiEngelMesaji</div>
                }
                @if (kisiEksikBelgeler.Count > 0)
                {
                    <div>Eksik/süresi geçmiş belge(ler): @string.Join(", ", kisiEksikBelgeler)</div>
                }
            </div>
        }
        @if (bulunanArac is null && !string.IsNullOrWhiteSpace(takipNumarasi))
        {
            <div class="alert alert-warning">
                <div>Araç girişi yapılmayacak — sadece kişi girişi kaydedilecek.</div>
                @if (aracEngelMesaji is not null)
                {
                    <div>@aracEngelMesaji</div>
                }
                @if (aracEksikBelgeler.Count > 0)
                {
                    <div>Eksik/süresi geçmiş belge(ler): @string.Join(", ", aracEksikBelgeler)</div>
                }
            </div>
        }

        <div class="row">
            @if (bulunanKisi is not null)
            {
                <div class="col-md-4 mb-2">
                    <label class="form-label">Ad Soyad</label>
                    <input class="form-control form-control-lg" value="@bulunanKisi.AdSoyad" disabled />
                </div>
            }
            <div class="col-md-4 mb-2">
                <label class="form-label">Firma Adı</label>
                <input class="form-control form-control-lg" @bind:get="onayFirmaAdi" @bind:set="v => onayFirmaAdi = MetinYardimci.BuyukHarf(v)" @bind:event="oninput" />
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">Telefon <span class="text-danger">*</span></label>
                <input class="form-control form-control-lg" @bind:get="onayTelefon" @bind:set="v => onayTelefon = v" @bind:event="oninput" placeholder="5XXXXXXXXX" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Tekne <span class="text-danger">*</span></label>
            <div class="d-flex align-items-center gap-2" style="max-width: 400px;">
                <input class="form-control form-control-lg"
                       @bind:get="tekneArama" @bind:set="TekneAramaDegisti" @bind:event="oninput"
                       autocomplete="off" placeholder="Tekne kodu veya adı ile ara..." />
                @if (onayTekneId is not null)
                {
                    <button type="button" class="btn btn-outline-secondary btn-lg" @onclick="TekneSecimiTemizle">✕</button>
                }
            </div>
            @if (eslesenTekneler.Count > 0)
            {
                <div class="list-group mt-1" style="max-width: 400px;">
                    @foreach (var tekne in eslesenTekneler)
                    {
                        <button type="button" class="list-group-item list-group-item-action py-1" @onclick="() => TekneSec(tekne)">
                            <strong>@tekne.TekneKodu</strong> — @tekne.TekneAdi
                        </button>
                    }
                </div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label">Açıklama</label>
            <textarea class="form-control" rows="2" maxlength="1000" @bind="onayAciklama"></textarea>
        </div>

        @if (hataMesaji is not null)
        {
            <div class="alert alert-danger">@hataMesaji</div>
        }

        <div>
            <button type="button" class="btn btn-lg btn-success" @onclick="GirisKaydet">Giriş Kaydet</button>
            <button type="button" class="btn btn-lg btn-secondary" @onclick="SorguyaDon">Vazgeç</button>
        </div>
    </div>
}

@if (kameraAcik)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center"
         style="background-color: rgba(0,0,0,0.85); z-index: 1050;">
        <div class="bg-white rounded p-3" style="max-width: 500px; width: 90%;">
            <h5 class="mb-3">Barkodu Kameraya Gösterin</h5>
            @if (kameraHataMesaji is not null)
            {
                <div class="alert alert-danger">@kameraHataMesaji</div>
            }
            <div id="barkod-video-alani" style="width: 100%;"></div>
            <button type="button" class="btn btn-secondary btn-lg w-100 mt-3" @onclick="KameraKapat">Kapat</button>
        </div>
    </div>
}

<script src="lib/html5-qrcode.min.js"></script>

@code {
    private enum Asama { Sorgu, Onay }

    private static readonly ZiyaretSebebi[] ziyaretSebepleri =
    [
        ZiyaretSebebi.Calisma,
        ZiyaretSebebi.Gorusme,
        ZiyaretSebebi.Kesif,
        ZiyaretSebebi.Kontrol,
        ZiyaretSebebi.MalzemeAlma,
        ZiyaretSebebi.MalzemeBirakma,
        ZiyaretSebebi.IskeleKurma
    ];

    private Asama asama = Asama.Sorgu;
    private string kimlikNumarasi = string.Empty;
    private string takipNumarasi = string.Empty;
    private List<Kisi> eslesenKisiler = [];
    private List<Arac> eslesenAraclar = [];
    private ZiyaretSebebi ziyaretSebebi = ZiyaretSebebi.Calisma;

    private string? kisiEngelMesaji;
    private bool kisiEngelYonlendirmeGoster;
    private List<string> kisiEksikBelgeler = [];
    private Kisi? bulunanKisi;
    private int? bulunanKisiId;

    private string? aracEngelMesaji;
    private bool aracEngelYonlendirmeGoster;
    private List<string> aracEksikBelgeler = [];
    private Arac? bulunanArac;
    private int? bulunanAracId;

    private string? onayFirmaAdi;
    private string? onayTelefon;
    private int? onayTekneId;
    private string tekneArama = string.Empty;
    private List<Tekne> eslesenTekneler = [];
    private string? onayAciklama;
    private List<string> yaklasanBelgeler = [];

    private List<Tekne> tekneler = [];
    private string? basariMesaji;
    private string? hataMesaji;

    private bool kameraAcik;
    private bool kameraTaramaBaslatildi;
    private string? kameraHataMesaji;
    private DotNetObjectReference<CekekTakip>? kameraDotNetRef;

    private async Task<string?> AktifKullaniciAdi()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        return authState.User?.Identity?.Name;
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        tekneler = await db.Tekneler.AsNoTracking().Where(t => t.Aktif).OrderBy(t => t.TekneKodu).ToListAsync();
    }

    // Kamera modal'ı @if ile açılınca DOM'a yeni giren "barkod-video-alani"
    // div'i ancak render sonrası hazır olur — bu yüzden tarama JS
    // interop'u burada, bayrak (kameraTaramaBaslatildi) ile tek seferlik
    // olarak tetiklenir.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (kameraAcik && !kameraTaramaBaslatildi)
        {
            kameraTaramaBaslatildi = true;
            kameraDotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("barkodTaramayiBaslat", kameraDotNetRef, "barkod-video-alani");
        }
    }

    private void KameraAc()
    {
        kameraHataMesaji = null;
        kameraTaramaBaslatildi = false;
        kameraAcik = true;
    }

    private async Task KameraKapat()
    {
        kameraAcik = false;
        kameraTaramaBaslatildi = false;
        kameraHataMesaji = null;
        try
        {
            await JS.InvokeVoidAsync("barkodTaramayiDurdur");
        }
        catch (JSDisconnectedException)
        {
            // Circuit zaten kapanmış olabilir (sayfadan ayrılma vb.), yoksay.
        }
    }

    [JSInvokable]
    public async Task BarkodOkundu(string sonuc)
    {
        await KameraKapat();
        await KimlikNumarasiDegisti(sonuc);
        StateHasChanged();
    }

    [JSInvokable]
    public void BarkodHata(string mesaj)
    {
        kameraHataMesaji = mesaj;
        kameraTaramaBaslatildi = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        kimlikAramaCts?.Cancel();
        takipAramaCts?.Cancel();

        if (kameraDotNetRef is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("barkodTaramayiDurdur");
            }
            catch (JSDisconnectedException)
            {
                // Circuit zaten kapanmış olabilir, yoksay.
            }
            kameraDotNetRef.Dispose();
        }
    }

    private static string ZiyaretSebebiAdi(ZiyaretSebebi sebep) => sebep switch
    {
        ZiyaretSebebi.Calisma => "Çalışma",
        ZiyaretSebebi.Gorusme => "Görüşme",
        ZiyaretSebebi.Kesif => "Keşif",
        ZiyaretSebebi.Kontrol => "Kontrol",
        ZiyaretSebebi.MalzemeAlma => "Malzeme Alma",
        ZiyaretSebebi.MalzemeBirakma => "Malzeme Bırakma",
        ZiyaretSebebi.IskeleKurma => "İskele Kurma",
        _ => sebep.ToString()
    };

    private static string AracTuruAdi(AracTuru tur) => tur switch
    {
        AracTuru.Arac => "Araç",
        AracTuru.Vinc => "Vinç",
        AracTuru.Vidanjor => "Vidanjör",
        AracTuru.Kompresor => "Kompresör",
        AracTuru.BasincliKap => "Basınçlı Kap",
        _ => tur.ToString()
    };

    private static bool ZiyaretSebebineUygulanir(KisiBelge belge, ZiyaretSebebi sebep) => sebep switch
    {
        ZiyaretSebebi.Calisma => belge.GecerliCalisma,
        ZiyaretSebebi.Gorusme => belge.GecerliGorusme,
        ZiyaretSebebi.Kesif => belge.GecerliKesif,
        ZiyaretSebebi.Kontrol => belge.GecerliKontrol,
        ZiyaretSebebi.MalzemeAlma => belge.GecerliMalzemeAlma,
        ZiyaretSebebi.MalzemeBirakma => belge.GecerliMalzemeBirakma,
        ZiyaretSebebi.IskeleKurma => belge.GecerliIskeleKurma,
        _ => false
    };

    private static bool AracTurineUygulanir(AracBelge belge, AracTuru tur) => tur switch
    {
        AracTuru.Arac => belge.GecerliArac,
        AracTuru.Vinc => belge.GecerliVinc,
        AracTuru.Vidanjor => belge.GecerliVidanjor,
        AracTuru.Kompresor => belge.GecerliKompresor,
        AracTuru.BasincliKap => belge.GecerliBasincliKap,
        _ => false
    };

    // Ziyaret Sebebi'ne göre içeride kalma süresi — süresiz sebeplerde null
    // (bkz. CLAUDE.md > Zamanlayıcı). Araç girişinde de aynı Ziyaret
    // Sebebi kullanılır.
    private static TimeSpan? SureLimiti(ZiyaretSebebi sebep) => sebep switch
    {
        ZiyaretSebebi.Kesif => TimeSpan.FromHours(1),
        ZiyaretSebebi.Kontrol => TimeSpan.FromHours(1),
        ZiyaretSebebi.MalzemeAlma => TimeSpan.FromMinutes(15),
        ZiyaretSebebi.MalzemeBirakma => TimeSpan.FromMinutes(15),
        _ => null
    };

    // Araç girişlerinde süre Ziyaret Sebebi'nden bağımsızdır (kişi girişleri
    // hâlâ yukarıdaki SureLimiti/Ziyaret Sebebi kuralını kullanır): Vinç ve
    // Vidanjör her zaman süresiz, diğer tüm araç türleri her zaman 15 dakika.
    private static TimeSpan? AracSureLimiti(AracTuru tur) => tur switch
    {
        AracTuru.Vinc => null,
        AracTuru.Vidanjor => null,
        _ => TimeSpan.FromMinutes(15)
    };

    // Barkod okuyucu karakterleri milisaniyeler içinde art arda gönderir;
    // her karakterde hemen DB sorgusu atarsak aynı (paylaşılan, circuit
    // başına tek) DbContext üzerinde üst üste binen sorgular "A second
    // operation was started on this context instance..." hatasına yol
    // açıyordu (2026-08-24'te fark edildi). Çözüm: son karakterden sonra
    // kısa bir sessizlik (debounce) bekleyip öyle sorgulamak — yeni bir
    // karakter/Kontrol gönderimi gelirse önceki bekleyen sorgu iptal edilir.
    private CancellationTokenSource? kimlikAramaCts;
    private CancellationTokenSource? takipAramaCts;

    private async Task KimlikNumarasiDegisti(string? v)
    {
        kimlikNumarasi = v ?? string.Empty;

        kimlikAramaCts?.Cancel();
        var cts = new CancellationTokenSource();
        kimlikAramaCts = cts;

        var arama = kimlikNumarasi.Trim();
        if (string.IsNullOrEmpty(arama))
        {
            eslesenKisiler = [];
            return;
        }

        try
        {
            await Task.Delay(200, cts.Token);
            await using var db = await DbFactory.CreateDbContextAsync(cts.Token);
            eslesenKisiler = await db.Kisiler.AsNoTracking()
                .Where(k => k.KimlikNumarasi.Contains(arama))
                .OrderBy(k => k.KimlikNumarasi)
                .Take(5)
                .ToListAsync(cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Kullanıcı yazmaya devam etti veya Kontrol'e bastı, bu arama artık geçersiz.
        }
    }

    private void EslesenKisiSec(Kisi eslesen)
    {
        kimlikNumarasi = eslesen.KimlikNumarasi;
        eslesenKisiler = [];
    }

    private async Task TakipNumarasiDegisti(string? v)
    {
        takipNumarasi = v ?? string.Empty;

        takipAramaCts?.Cancel();
        var cts = new CancellationTokenSource();
        takipAramaCts = cts;

        var arama = takipNumarasi.Trim();
        if (string.IsNullOrEmpty(arama))
        {
            eslesenAraclar = [];
            return;
        }

        try
        {
            await Task.Delay(200, cts.Token);
            await using var db = await DbFactory.CreateDbContextAsync(cts.Token);
            eslesenAraclar = await db.Araclar.AsNoTracking()
                .Where(a => a.TakipNumarasi.Contains(arama))
                .OrderBy(a => a.TakipNumarasi)
                .Take(5)
                .ToListAsync(cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Kullanıcı yazmaya devam etti veya Kontrol'e bastı, bu arama artık geçersiz.
        }
    }

    private void EslesenAracSec(Arac eslesen)
    {
        takipNumarasi = eslesen.TakipNumarasi;
        eslesenAraclar = [];
    }

    // Tekneler zaten OnInitializedAsync'te belleğe yüklendiği için burada
    // yeni bir DB sorgusu gerekmiyor (Kimlik/Takip No aramalarının aksine)
    // — filtreleme tamamen bellek içinde yapılıyor.
    // onayTekneId burada HER yazışta null'a çekilir: kullanıcı bir tekne
    // seçtikten sonra kutuya tekrar yazarsa, ekrandaki metinle kayıtta
    // gidecek TekneId'nin uyuşmadığı bir ara durum oluşmasın diye — geçerli
    // bir Id yalnızca listeden TekneSec ile tıklanarak seçildiğinde set edilir.
    private void TekneAramaDegisti(string? v)
    {
        tekneArama = v ?? string.Empty;
        onayTekneId = null;

        var arama = tekneArama.Trim();
        eslesenTekneler = string.IsNullOrEmpty(arama)
            ? []
            : tekneler
                .Where(t => t.TekneKodu.Contains(arama, StringComparison.OrdinalIgnoreCase)
                         || t.TekneAdi.Contains(arama, StringComparison.OrdinalIgnoreCase))
                .Take(8)
                .ToList();
    }

    private void TekneSec(Tekne tekne)
    {
        onayTekneId = tekne.Id;
        tekneArama = $"{tekne.TekneKodu} — {tekne.TekneAdi}";
        eslesenTekneler = [];
    }

    private void TekneSecimiTemizle()
    {
        onayTekneId = null;
        tekneArama = string.Empty;
        eslesenTekneler = [];
    }

    private async Task KontrolYap()
    {
        kimlikAramaCts?.Cancel();
        takipAramaCts?.Cancel();

        basariMesaji = null;
        kisiEngelMesaji = null;
        kisiEngelYonlendirmeGoster = false;
        kisiEksikBelgeler = [];
        bulunanKisi = null;
        bulunanKisiId = null;
        aracEngelMesaji = null;
        aracEngelYonlendirmeGoster = false;
        aracEksikBelgeler = [];
        bulunanArac = null;
        bulunanAracId = null;
        yaklasanBelgeler = [];
        eslesenKisiler = [];
        eslesenAraclar = [];

        var kimlik = kimlikNumarasi.Trim();
        var takip = takipNumarasi.Trim();

        if (string.IsNullOrWhiteSpace(kimlik) && string.IsNullOrWhiteSpace(takip))
        {
            kisiEngelMesaji = "Kimlik numarası veya takip numarası girin.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        if (!string.IsNullOrWhiteSpace(kimlik))
        {
            await KisiKontrolYap(db, kimlik);
        }

        if (!string.IsNullOrWhiteSpace(takip))
        {
            await AracKontrolYap(db, takip);
        }

        // İkisi birden başarılı olmak zorunda değil — hangisi geçerse
        // Onay aşamasına geçilir, sadece başarılı olan(lar) kaydedilir.
        if (bulunanKisi is not null || bulunanArac is not null)
        {
            onayFirmaAdi = bulunanKisi?.FirmaAdi ?? bulunanArac?.FirmaAdi;
            onayTelefon = bulunanKisi?.Telefon;
            onayTekneId = null;
            tekneArama = string.Empty;
            eslesenTekneler = [];
            onayAciklama = null;
            asama = Asama.Onay;
        }
    }

    private async Task KisiKontrolYap(ApplicationDbContext db, string kimlik)
    {
        var kisi = await db.Kisiler.AsNoTracking().FirstOrDefaultAsync(k => k.KimlikNumarasi == kimlik);
        if (kisi is null)
        {
            kisiEngelMesaji = "Bu kimlik numarasıyla kayıtlı bir kişi bulunamadı.";
            kisiEngelYonlendirmeGoster = true;
            return;
        }

        bulunanKisiId = kisi.Id;

        if (!kisi.Aktif)
        {
            kisiEngelMesaji = !string.IsNullOrEmpty(kisi.YasaklanmaSebebi)
                ? $"Saha kontrolüne haber verilmeli, yasaklı kişi tespit edildi. (Sebep: {kisi.YasaklanmaSebebi})"
                : "Bu kişi aktif değil.";
            kisiEngelYonlendirmeGoster = true;
            return;
        }

        var acikKaydiVarMi = await db.CekekTakipleri.AnyAsync(c => c.KisiId == kisi.Id && c.CikisTarihi == null);
        if (acikKaydiVarMi)
        {
            kisiEngelMesaji = "Bu kişinin sahada çıkışı yapılmamış açık bir kaydı var, tekrar giriş yapılamaz.";
            return;
        }

        var kurallar = await db.KisiBelgeleri.AsNoTracking().Where(b => b.Aktif).ToListAsync();
        var uygulanabilirKurallar = kurallar.Where(b => ZiyaretSebebineUygulanir(b, ziyaretSebebi)).ToList();
        var kontroller = await db.KisiBelgeKontrolleri.AsNoTracking().Where(k => k.KisiId == kisi.Id).ToListAsync();

        var eksikler = new List<string>();

        if (!kisi.KvkkOnayFormuAlindi)
        {
            eksikler.Add("KVKK Onay Formu");
        }

        foreach (var kural in uygulanabilirKurallar)
        {
            var kontrol = kontroller.FirstOrDefault(k => k.KisiBelgeId == kural.Id);
            if (kontrol is null || !kontrol.AlindiSonucu)
            {
                eksikler.Add(kural.BelgeTanimi);
            }
            else if (kural.GecerlilikTarihiKontrolu &&
                     (kontrol.GecerlilikTarihiSonucu is null || kontrol.GecerlilikTarihiSonucu.Value.Date < DateTime.Today))
            {
                eksikler.Add($"{kural.BelgeTanimi} (süresi geçmiş)");
            }
        }

        if (eksikler.Count > 0)
        {
            kisiEksikBelgeler = eksikler;
            return;
        }

        var yaklasanlar = new List<string>();
        foreach (var kural in uygulanabilirKurallar)
        {
            if (!kural.GecerlilikTarihiKontrolu)
            {
                continue;
            }

            var kontrol = kontroller.FirstOrDefault(k => k.KisiBelgeId == kural.Id);
            if (kontrol?.GecerlilikTarihiSonucu is DateTime tarih)
            {
                var kalanGun = (tarih.Date - DateTime.Today).Days;
                if (kalanGun is >= 0 and <= 10)
                {
                    yaklasanlar.Add($"{kural.BelgeTanimi} (bitiş: {tarih:dd.MM.yyyy}, {kalanGun} gün kaldı)");
                }
            }
        }
        yaklasanBelgeler = yaklasanlar;

        bulunanKisi = kisi;
    }

    private async Task AracKontrolYap(ApplicationDbContext db, string takip)
    {
        var arac = await db.Araclar.AsNoTracking().FirstOrDefaultAsync(a => a.TakipNumarasi == takip);
        if (arac is null)
        {
            aracEngelMesaji = "Bu takip numarasıyla kayıtlı bir araç bulunamadı.";
            aracEngelYonlendirmeGoster = true;
            return;
        }

        bulunanAracId = arac.Id;

        if (!arac.Aktif)
        {
            aracEngelMesaji = !string.IsNullOrEmpty(arac.YasaklanmaSebebi)
                ? $"Saha kontrolüne haber verilmeli, yasaklı araç tespit edildi. (Sebep: {arac.YasaklanmaSebebi})"
                : "Bu araç aktif değil.";
            aracEngelYonlendirmeGoster = true;
            return;
        }

        var acikKaydiVarMi = await db.CekekTakipleri.AnyAsync(c => c.AracId == arac.Id && c.CikisTarihi == null);
        if (acikKaydiVarMi)
        {
            aracEngelMesaji = "Bu aracın sahada çıkışı yapılmamış açık bir kaydı var, tekrar giriş yapılamaz.";
            return;
        }

        // Araç belgeleri Ziyaret Sebebi'nden bağımsız, AracTuru'ne göre
        // filtrelenir; KVKK benzeri özel bir kontrol yok.
        var kurallar = await db.AracBelgeleri.AsNoTracking().Where(b => b.Aktif).ToListAsync();
        var uygulanabilirKurallar = kurallar.Where(b => AracTurineUygulanir(b, arac.AracTuru)).ToList();
        var kontroller = await db.AracBelgeKontrolleri.AsNoTracking().Where(k => k.AracId == arac.Id).ToListAsync();

        var eksikler = new List<string>();

        foreach (var kural in uygulanabilirKurallar)
        {
            var kontrol = kontroller.FirstOrDefault(k => k.AracBelgeId == kural.Id);
            if (kontrol is null || !kontrol.AlindiSonucu)
            {
                eksikler.Add(kural.BelgeTanimi);
            }
            else if (kural.GecerlilikTarihiKontrolu &&
                     (kontrol.GecerlilikTarihiSonucu is null || kontrol.GecerlilikTarihiSonucu.Value.Date < DateTime.Today))
            {
                eksikler.Add($"{kural.BelgeTanimi} (süresi geçmiş)");
            }
        }

        if (eksikler.Count > 0)
        {
            aracEksikBelgeler = eksikler;
            return;
        }

        bulunanArac = arac;
    }

    private async Task GirisKaydet()
    {
        if (bulunanKisi is null && bulunanArac is null)
        {
            return;
        }

        hataMesaji = null;

        if (onayTekneId is null)
        {
            hataMesaji = "Tekne seçimi zorunlu.";
            return;
        }

        if (string.IsNullOrWhiteSpace(onayTelefon))
        {
            hataMesaji = "Telefon zorunlu.";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var simdi = DateTime.Now;
            var sure = SureLimiti(ziyaretSebebi);
            DateTime? beklenenBitis = sure is null ? null : simdi.Add(sure.Value);

            // Firma Adı/Telefon burada yalnızca o günkü Çekek Takip kaydının
            // anlık görüntüsüne (snapshot) yazılır — artık Kisi/Arac kaydına
            // geri senkronize edilmiyor (2026-08-26'dan itibaren, bilerek:
            // kullanıcı bu alanı yanlışlıkla boşaltırsa kişinin/aracın asıl
            // kaydındaki bilgi silinmiş oluyordu). Kişi/Araç bilgisini
            // güncellemek için hâlâ /kisiler ve /araclar ekranları kullanılır.
            if (bulunanKisi is not null)
            {
                var kisiGiris = new ViaCekek.Web.Models.CekekTakip
                {
                    KisiId = bulunanKisi.Id,
                    KimlikNumarasi = bulunanKisi.KimlikNumarasi,
                    AdSoyad = bulunanKisi.AdSoyad,
                    FirmaAdi = onayFirmaAdi,
                    Telefon = onayTelefon,
                    TekneId = onayTekneId,
                    GirisTarihi = DateOnly.FromDateTime(simdi),
                    GirisSaati = TimeOnly.FromDateTime(simdi),
                    ZiyaretSebebi = ziyaretSebebi,
                    Durum = CekekTakipDurumu.GirisYapildi,
                    BeklenenBitisZamani = beklenenBitis,
                    Aciklama = onayAciklama
                };
                db.CekekTakipleri.Add(kisiGiris);
            }

            if (bulunanArac is not null)
            {
                var aracSure = AracSureLimiti(bulunanArac.AracTuru);
                DateTime? aracBeklenenBitis = aracSure is null ? null : simdi.Add(aracSure.Value);

                var aracGiris = new ViaCekek.Web.Models.CekekTakip
                {
                    AracId = bulunanArac.Id,
                    TakipNumarasi = bulunanArac.TakipNumarasi,
                    AdSoyad = bulunanKisi?.AdSoyad,
                    FirmaAdi = onayFirmaAdi,
                    Telefon = onayTelefon,
                    TekneId = onayTekneId,
                    GirisTarihi = DateOnly.FromDateTime(simdi),
                    GirisSaati = TimeOnly.FromDateTime(simdi),
                    ZiyaretSebebi = ziyaretSebebi,
                    Durum = CekekTakipDurumu.GirisYapildi,
                    BeklenenBitisZamani = aracBeklenenBitis,
                    Aciklama = onayAciklama
                };
                db.CekekTakipleri.Add(aracGiris);
            }

            db.MevcutKullanici = await AktifKullaniciAdi();
            await db.SaveChangesAsync();

            var parcalar = new List<string>();
            if (bulunanKisi is not null)
            {
                parcalar.Add(bulunanKisi.AdSoyad);
            }
            if (bulunanArac is not null)
            {
                parcalar.Add(bulunanArac.TakipNumarasi);
            }
            basariMesaji = $"{string.Join(" / ", parcalar)} için giriş kaydedildi.";

            SorguyaDon();
        }
        catch (DbUpdateException)
        {
            hataMesaji = "Kayıt sırasında bir hata oluştu, tekrar deneyin.";
        }
    }

    private void SorguyaDon()
    {
        asama = Asama.Sorgu;
        kimlikNumarasi = string.Empty;
        takipNumarasi = string.Empty;
        eslesenKisiler = [];
        eslesenAraclar = [];
        bulunanKisi = null;
        bulunanKisiId = null;
        kisiEksikBelgeler = [];
        kisiEngelMesaji = null;
        kisiEngelYonlendirmeGoster = false;
        bulunanArac = null;
        bulunanAracId = null;
        aracEksikBelgeler = [];
        aracEngelMesaji = null;
        aracEngelYonlendirmeGoster = false;
        yaklasanBelgeler = [];
        hataMesaji = null;
    }
}
