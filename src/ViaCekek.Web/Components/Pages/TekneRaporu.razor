@page "/tekneraporu"
@attribute [Authorize(Roles = $"{Roller.Yonetici},{Roller.SahaKontroloru}")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ViaCekek.Web.Data
@using ViaCekek.Web.Models
@using ClosedXML.Excel
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Tekneler Raporu</PageTitle>

<h3>Tekneler Raporu</h3>

<div class="card card-body mb-3">
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Tekne Kodu</label>
            <div class="input-group">
                <select class="form-select" style="max-width: 140px;" @bind="tekneKoduFiltre.Operator">
                    <option value="@MetinOperatoru.Icerir">İçerir</option>
                    <option value="@MetinOperatoru.Esittir">Eşittir</option>
                    <option value="@MetinOperatoru.BaslarIle">Başlar ile</option>
                </select>
                <input class="form-control" @bind="tekneKoduFiltre.Deger" />
            </div>
        </div>

        <div class="col-md-4">
            <label class="form-label">Tekne Adı</label>
            <div class="input-group">
                <select class="form-select" style="max-width: 140px;" @bind="tekneAdiFiltre.Operator">
                    <option value="@MetinOperatoru.Icerir">İçerir</option>
                    <option value="@MetinOperatoru.Esittir">Eşittir</option>
                    <option value="@MetinOperatoru.BaslarIle">Başlar ile</option>
                </select>
                <input class="form-control" @bind="tekneAdiFiltre.Deger" />
            </div>
        </div>

        <div class="col-md-4">
            <label class="form-label">Aktif</label>
            <select class="form-select" @bind="aktifSecim">
                <option value="">Tümü</option>
                <option value="true">Aktif</option>
                <option value="false">Pasif</option>
            </select>
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-lg btn-primary" @onclick="Filtrele">Filtrele</button>
        <button class="btn btn-lg btn-secondary" @onclick="FiltreleriTemizle">Temizle</button>
        <button class="btn btn-lg btn-success" @onclick="ExcelAktar" disabled="@(sonuclar is null || sonuclar.Count == 0)">Excel'e Aktar</button>
    </div>
</div>

@if (sonuclar is null)
{
    <p>Filtrelemek için "Filtrele"ye basın.</p>
}
else if (sonuclar.Count == 0)
{
    <p>Sonuç bulunamadı.</p>
}
else
{
    <p>@sonuclar.Count kayıt bulundu.</p>
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Tekne Kodu</th>
                    <th>Tekne Adı</th>
                    <th>Aktif</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tekne in sonuclar)
                {
                    <tr>
                        <td>@tekne.TekneKodu</td>
                        <td>@tekne.TekneAdi</td>
                        <td>@(tekne.Aktif ? "Aktif" : "Pasif")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private enum MetinOperatoru { Icerir, Esittir, BaslarIle }

    private sealed class MetinFiltre
    {
        public MetinOperatoru Operator { get; set; } = MetinOperatoru.Icerir;
        public string Deger { get; set; } = string.Empty;
    }

    private MetinFiltre tekneKoduFiltre = new();
    private MetinFiltre tekneAdiFiltre = new();
    private string aktifSecim = string.Empty;

    private static bool? SecimToBool(string secim) => secim switch
    {
        "true" => true,
        "false" => false,
        _ => null
    };

    private List<Tekne>? sonuclar;

    private async Task Filtrele()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var sorgu = db.Tekneler.AsNoTracking().AsQueryable();

        if (!string.IsNullOrWhiteSpace(tekneKoduFiltre.Deger))
        {
            var deger = tekneKoduFiltre.Deger.Trim();
            sorgu = tekneKoduFiltre.Operator switch
            {
                MetinOperatoru.Esittir => sorgu.Where(t => t.TekneKodu == deger),
                MetinOperatoru.BaslarIle => sorgu.Where(t => t.TekneKodu.StartsWith(deger)),
                _ => sorgu.Where(t => t.TekneKodu.Contains(deger))
            };
        }

        if (!string.IsNullOrWhiteSpace(tekneAdiFiltre.Deger))
        {
            var deger = tekneAdiFiltre.Deger.Trim();
            sorgu = tekneAdiFiltre.Operator switch
            {
                MetinOperatoru.Esittir => sorgu.Where(t => t.TekneAdi == deger),
                MetinOperatoru.BaslarIle => sorgu.Where(t => t.TekneAdi.StartsWith(deger)),
                _ => sorgu.Where(t => t.TekneAdi.Contains(deger))
            };
        }

        var aktifFiltre = SecimToBool(aktifSecim);
        if (aktifFiltre is not null)
        {
            sorgu = sorgu.Where(t => t.Aktif == aktifFiltre);
        }

        sonuclar = await sorgu
            .OrderBy(t => t.TekneKodu)
            .ToListAsync();
    }

    private void FiltreleriTemizle()
    {
        tekneKoduFiltre = new();
        tekneAdiFiltre = new();
        aktifSecim = string.Empty;
        sonuclar = null;
    }

    private async Task ExcelAktar()
    {
        if (sonuclar is null || sonuclar.Count == 0)
        {
            return;
        }

        using var workbook = new XLWorkbook();
        var sayfa = workbook.Worksheets.Add("Rapor");

        string[] basliklar = ["Tekne Kodu", "Tekne Adı", "Aktif"];
        for (var i = 0; i < basliklar.Length; i++)
        {
            sayfa.Cell(1, i + 1).Value = basliklar[i];
            sayfa.Cell(1, i + 1).Style.Font.Bold = true;
        }

        var satir = 2;
        foreach (var tekne in sonuclar)
        {
            sayfa.Cell(satir, 1).Value = tekne.TekneKodu;
            sayfa.Cell(satir, 2).Value = tekne.TekneAdi;
            sayfa.Cell(satir, 3).Value = tekne.Aktif ? "Aktif" : "Pasif";
            satir++;
        }

        sayfa.Columns().AdjustToContents();

        using var akis = new MemoryStream();
        workbook.SaveAs(akis);
        var base64 = Convert.ToBase64String(akis.ToArray());

        var dosyaAdi = $"TeknelerRaporu_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
        await JS.InvokeVoidAsync("dosyaIndir", dosyaAdi, base64,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }
}
