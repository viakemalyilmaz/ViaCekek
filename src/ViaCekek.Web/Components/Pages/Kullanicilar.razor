@page "/kullanicilar"
@attribute [Authorize(Roles = Roller.Yonetici)]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ViaCekek.Web.Data
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager

<PageTitle>Kullanıcılar</PageTitle>

<h3>Kullanıcılar</h3>

@if (hataMesaji is not null)
{
    <div class="alert alert-danger">@hataMesaji</div>
}

<button class="btn btn-lg btn-primary mb-3" @onclick="YeniKullaniciBaslat">+ Yeni Kullanıcı</button>

@if (formAcik)
{
    <EditForm Model="formu" OnValidSubmit="Kaydet" class="card card-body mb-3">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-2">
            <label class="form-label">E-posta</label>
            <InputText class="form-control" @bind-Value="formu.Email" disabled="@(formu.Id is not null)" />
        </div>
        @if (formu.Id is null)
        {
            <div class="mb-2">
                <label class="form-label">Şifre</label>
                <InputText type="password" class="form-control" @bind-Value="formu.Sifre" />
            </div>
        }
        <div class="mb-3">
            <label class="form-label">Rol</label>
            <InputSelect class="form-select" @bind-Value="formu.Rol">
                @foreach (var rol in Roller.Hepsi)
                {
                    <option value="@rol">@rol</option>
                }
            </InputSelect>
        </div>
        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="formu.Aktif" id="aktifCheck" />
            <label class="form-check-label" for="aktifCheck">Aktif</label>
        </div>

        <div>
            <button type="submit" class="btn btn-lg btn-success">Kaydet</button>
            <button type="button" class="btn btn-lg btn-secondary" @onclick="FormuKapat">Kapat</button>
        </div>
    </EditForm>
}

@if (!formAcik)
{
@if (kullanicilar is null)
{
    <p>Yükleniyor...</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>E-posta</th>
                <th>Rol</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (kullanici, rol, aktif) in kullanicilar)
            {
                <tr>
                    <td>@kullanici.Email</td>
                    <td>@rol</td>
                    <td>
                        @if (aktif)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-outline-primary" @onclick="() => DuzenlemeBaslat(kullanici, rol, aktif)">Düzenle</button>
                        <button class="btn btn-outline-secondary" @onclick="() => SifreSifirlamaBaslat(kullanici)">Şifre Sıfırla</button>
                    </td>
                </tr>
                @if (sifreSifirlananKullaniciId == kullanici.Id)
                {
                    <tr>
                        <td colspan="4">
                            <EditForm Model="sifreSifirlama" OnValidSubmit="SifreSifirla" class="card card-body">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                @if (sifreHataMesaji is not null)
                                {
                                    <div class="alert alert-danger">@sifreHataMesaji</div>
                                }
                                <div class="mb-2">
                                    <label class="form-label">@kullanici.Email için yeni şifre</label>
                                    <InputText type="password" class="form-control" @bind-Value="sifreSifirlama.YeniSifre" />
                                </div>
                                <div>
                                    <button type="submit" class="btn btn-success">Şifreyi Değiştir</button>
                                    <button type="button" class="btn btn-secondary" @onclick="SifreSifirlamaIptal">Kapat</button>
                                </div>
                            </EditForm>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>
}
}

@code {
    private List<(ApplicationUser Kullanici, string? Rol, bool Aktif)>? kullanicilar;
    private KullaniciFormu formu = new();
    private bool formAcik;
    private string? hataMesaji;

    private string? sifreSifirlananKullaniciId;
    private SifreSifirlamaModeli sifreSifirlama = new();
    private string? sifreHataMesaji;

    protected override async Task OnInitializedAsync()
    {
        await ListeyiYenile();
    }

    private async Task ListeyiYenile()
    {
        var tumKullanicilar = UserManager.Users.ToList();
        var liste = new List<(ApplicationUser, string?, bool)>();
        foreach (var kullanici in tumKullanicilar)
        {
            var roller = await UserManager.GetRolesAsync(kullanici);
            var aktif = kullanici.LockoutEnd is null || kullanici.LockoutEnd <= DateTimeOffset.UtcNow;
            liste.Add((kullanici, roller.FirstOrDefault(), aktif));
        }
        kullanicilar = liste.OrderBy(k => k.Item1.Email).ToList();
    }

    private void YeniKullaniciBaslat()
    {
        formu = new KullaniciFormu { Rol = Roller.Guvenlik, Aktif = true };
        hataMesaji = null;
        formAcik = true;
    }

    private void DuzenlemeBaslat(ApplicationUser kullanici, string? rol, bool aktif)
    {
        formu = new KullaniciFormu
        {
            Id = kullanici.Id,
            Email = kullanici.Email ?? string.Empty,
            Rol = rol ?? Roller.Guvenlik,
            Aktif = aktif
        };
        hataMesaji = null;
        formAcik = true;
    }

    private void FormuKapat()
    {
        formAcik = false;
        hataMesaji = null;
    }

    private async Task Kaydet()
    {
        hataMesaji = null;

        if (formu.Id is null)
        {
            if (string.IsNullOrWhiteSpace(formu.Sifre))
            {
                hataMesaji = "Şifre zorunludur.";
                return;
            }

            var yeniKullanici = new ApplicationUser
            {
                UserName = formu.Email,
                Email = formu.Email,
                EmailConfirmed = true
            };

            var sonuc = await UserManager.CreateAsync(yeniKullanici, formu.Sifre);
            if (!sonuc.Succeeded)
            {
                hataMesaji = string.Join(" ", sonuc.Errors.Select(e => e.Description));
                return;
            }

            await UserManager.AddToRoleAsync(yeniKullanici, formu.Rol);

            if (!formu.Aktif)
            {
                await UserManager.SetLockoutEndDateAsync(yeniKullanici, DateTimeOffset.MaxValue);
            }
        }
        else
        {
            var kullanici = await UserManager.FindByIdAsync(formu.Id);
            if (kullanici is null)
            {
                hataMesaji = "Kullanıcı bulunamadı, sayfayı yenileyin.";
                return;
            }

            var mevcutRoller = await UserManager.GetRolesAsync(kullanici);
            if (mevcutRoller.Count > 0)
            {
                await UserManager.RemoveFromRolesAsync(kullanici, mevcutRoller);
            }
            await UserManager.AddToRoleAsync(kullanici, formu.Rol);

            await UserManager.SetLockoutEndDateAsync(kullanici, formu.Aktif ? null : DateTimeOffset.MaxValue);
        }

        formAcik = false;
        await ListeyiYenile();
    }

    private void SifreSifirlamaBaslat(ApplicationUser kullanici)
    {
        sifreSifirlananKullaniciId = kullanici.Id;
        sifreSifirlama = new SifreSifirlamaModeli();
        sifreHataMesaji = null;
    }

    private void SifreSifirlamaIptal()
    {
        sifreSifirlananKullaniciId = null;
        sifreHataMesaji = null;
    }

    private async Task SifreSifirla()
    {
        sifreHataMesaji = null;

        var kullanici = await UserManager.FindByIdAsync(sifreSifirlananKullaniciId!);
        if (kullanici is null)
        {
            sifreHataMesaji = "Kullanıcı bulunamadı, sayfayı yenileyin.";
            return;
        }

        var token = await UserManager.GeneratePasswordResetTokenAsync(kullanici);
        var sonuc = await UserManager.ResetPasswordAsync(kullanici, token, sifreSifirlama.YeniSifre);
        if (!sonuc.Succeeded)
        {
            sifreHataMesaji = string.Join(" ", sonuc.Errors.Select(e => e.Description));
            return;
        }

        sifreSifirlananKullaniciId = null;
    }

    private sealed class KullaniciFormu
    {
        public string? Id { get; set; }

        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        public string? Sifre { get; set; }

        [Required]
        public string Rol { get; set; } = Roller.Guvenlik;

        public bool Aktif { get; set; } = true;
    }

    private sealed class SifreSifirlamaModeli
    {
        [Required, MinLength(6)]
        public string YeniSifre { get; set; } = string.Empty;
    }
}
