@page "/kullanicilar"
@attribute [Authorize(Roles = Roller.Yonetici)]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using ViaCekek.Web.Data
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager

<PageTitle>Kullanıcılar</PageTitle>

<h3>Kullanıcılar</h3>

@if (hataMesaji is not null)
{
    <div class="alert alert-danger">@hataMesaji</div>
}

<button class="btn btn-primary mb-3" @onclick="YeniKullaniciBaslat">+ Yeni Kullanıcı</button>

@if (formAcik)
{
    <EditForm Model="yeniKullanici" OnValidSubmit="Kaydet" class="card card-body mb-3">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-2">
            <label class="form-label">E-posta</label>
            <InputText class="form-control" @bind-Value="yeniKullanici.Email" />
        </div>
        <div class="mb-2">
            <label class="form-label">Şifre</label>
            <InputText type="password" class="form-control" @bind-Value="yeniKullanici.Sifre" />
        </div>
        <div class="mb-3">
            <label class="form-label">Rol</label>
            <InputSelect class="form-select" @bind-Value="yeniKullanici.Rol">
                @foreach (var rol in Roller.Hepsi)
                {
                    <option value="@rol">@rol</option>
                }
            </InputSelect>
        </div>

        <div>
            <button type="submit" class="btn btn-success">Kaydet</button>
            <button type="button" class="btn btn-secondary" @onclick="FormuKapat">İptal</button>
        </div>
    </EditForm>
}

@if (kullanicilar is null)
{
    <p>Yükleniyor...</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>E-posta</th>
                <th>Rol</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (kullanici, mevcutRol) in kullanicilar)
            {
                <tr>
                    <td>@kullanici.Email</td>
                    <td>
                        <select class="form-select form-select-sm" style="width: auto; display: inline-block;"
                                value="@mevcutRol"
                                @onchange="e => RolDegistir(kullanici, e.Value?.ToString())">
                            @foreach (var rol in Roller.Hepsi)
                            {
                                <option value="@rol">@rol</option>
                            }
                        </select>
                    </td>
                    <td></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<(ApplicationUser Kullanici, string? Rol)>? kullanicilar;
    private YeniKullaniciModeli yeniKullanici = new();
    private bool formAcik;
    private string? hataMesaji;

    protected override async Task OnInitializedAsync()
    {
        await ListeyiYenile();
    }

    private async Task ListeyiYenile()
    {
        var tumKullanicilar = UserManager.Users.ToList();
        var liste = new List<(ApplicationUser, string?)>();
        foreach (var kullanici in tumKullanicilar)
        {
            var roller = await UserManager.GetRolesAsync(kullanici);
            liste.Add((kullanici, roller.FirstOrDefault()));
        }
        kullanicilar = liste.OrderBy(k => k.Item1.Email).ToList();
    }

    private void YeniKullaniciBaslat()
    {
        yeniKullanici = new YeniKullaniciModeli { Rol = Roller.Guvenlik };
        hataMesaji = null;
        formAcik = true;
    }

    private void FormuKapat()
    {
        formAcik = false;
        hataMesaji = null;
    }

    private async Task Kaydet()
    {
        hataMesaji = null;

        var kullanici = new ApplicationUser
        {
            UserName = yeniKullanici.Email,
            Email = yeniKullanici.Email,
            EmailConfirmed = true
        };

        var sonuc = await UserManager.CreateAsync(kullanici, yeniKullanici.Sifre);
        if (!sonuc.Succeeded)
        {
            hataMesaji = string.Join(" ", sonuc.Errors.Select(e => e.Description));
            return;
        }

        await UserManager.AddToRoleAsync(kullanici, yeniKullanici.Rol);

        formAcik = false;
        await ListeyiYenile();
    }

    private async Task RolDegistir(ApplicationUser kullanici, string? yeniRol)
    {
        if (string.IsNullOrEmpty(yeniRol))
        {
            return;
        }

        var mevcutRoller = await UserManager.GetRolesAsync(kullanici);
        if (mevcutRoller.Count > 0)
        {
            await UserManager.RemoveFromRolesAsync(kullanici, mevcutRoller);
        }

        await UserManager.AddToRoleAsync(kullanici, yeniRol);
        await ListeyiYenile();
    }

    private sealed class YeniKullaniciModeli
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required, MinLength(6)]
        public string Sifre { get; set; } = string.Empty;

        [Required]
        public string Rol { get; set; } = Roller.Guvenlik;
    }
}
